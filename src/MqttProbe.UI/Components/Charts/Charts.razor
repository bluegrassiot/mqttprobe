@using MqttProbe.Core.Services.Configuration
@inject IChartSettings ChartSettings
@inject ISessionState SessionState
@inject IChartDataService ChartDataService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IUxMetricsService? UxMetrics
@implements IAsyncDisposable

<TabPanelHeader Title="Charts" Icon="@LucideIcons.Activity">
    <HeaderActions>
        <AppPrimaryButton Size="Size.Small"
                          StartIcon="@LucideIcons.Plus" OnClick="CreateChart">
            Configure New
        </AppPrimaryButton>
    </HeaderActions>
    <HeaderFilters>
        <MudSelect T="ChartRendererKind" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined"
                   Value="@_renderer" ValueChanged="@OnRendererChanged"
                   Label="Renderer" Class="charts-renderer-select"
                   RelativeWidth="DropdownWidth.Adaptive">
            <MudSelectItem T="ChartRendererKind" Value="ChartRendererKind.Apex">ApexCharts</MudSelectItem>
            <MudSelectItem T="ChartRendererKind" Value="ChartRendererKind.ECharts">ECharts (preview)</MudSelectItem>
        </MudSelect>
    </HeaderFilters>
</TabPanelHeader>

@{
    var charts = ChartSettings.GetCharts(SessionState.SelectedConnection.Id);
}

<div class="tab-panel-scroll">
    @if (!charts.Any())
    {
        <div class="d-flex flex-column align-center justify-center charts-empty-state">
            <MudIcon Icon="@LucideIcons.Activity" Class="charts-empty-icon"/>
            <MudText Typo="Typo.h6" Color="Color.Secondary">No charts yet</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Class="charts-empty-copy">
                Choose the chart icon beside a value in <strong>Browser</strong> or <strong>Nodes</strong> to start a chart.
            </MudText>
        </div>
    }
    else
    {
        <MudStack Spacing="4">
            @foreach (var config in charts)
            {
                <ChartCard @key="config.Id"
                           Configuration="config"
                           Renderer="_renderer"
                           OnRendererRollback="UseApex"
                           OnEdit="EditChart"
                           OnDelete="DeleteChart" />
            }
        </MudStack>
    }
</div>

@code {
    private ChartRendererKind _renderer = ChartRendererKind.Apex;

    private void OnRendererChanged(ChartRendererKind renderer)
    {
        if (renderer == _renderer) return;
        _renderer = renderer;
        StateHasChanged();
    }

    private void UseApex() => OnRendererChanged(ChartRendererKind.Apex);

    protected override async Task OnInitializedAsync()
    {
        await ChartDataService.StartAsync();
        ChartDataService.SetConnection(SessionState.SelectedConnection.Id);
        ChartSettings.ChartsChanged += OnConfigurationsChanged;
        SessionState.SelectedConnectionChanged += OnSelectedConnectionChanged;
    }

    private void OnConfigurationsChanged(Guid connectionId)
    {
        if (connectionId != SessionState.SelectedConnection.Id) return;
        InvokeAsync(StateHasChanged);
    }

    private void OnSelectedConnectionChanged(Connection _) =>
        InvokeAsync(() =>
        {
            ChartDataService.SetConnection(SessionState.SelectedConnection.Id);
            StateHasChanged();
        });

    private async Task CreateChart()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<AddEditChartDialog>("Create Chart", options);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: ChartConfiguration created })
        {
                await ChartSettings.AddChartAsync(SessionState.SelectedConnection.Id, created);
            UxMetrics?.RecordChartFunnel("charts-tab", createdNewChart: true);
            Snackbar.Add($"Chart created: {created.Name}", Severity.Success);
        }
    }

    private async Task EditChart(ChartConfiguration config)
    {
        var parameters = new DialogParameters<AddEditChartDialog>
        {
            { d => d.Configuration, config }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<AddEditChartDialog>("Edit Chart", parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: ChartConfiguration updated })
        {
                await ChartSettings.UpdateChartAsync(SessionState.SelectedConnection.Id, updated);
            Snackbar.Add($"Chart updated: {updated.Name}", Severity.Success);
        }
    }

    private async Task DeleteChart(ChartConfiguration config)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete Chart",
            $"Delete '{config.Name}'?",
            yesText: "Delete", cancelText: "Cancel",
            options: new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (confirmed == true)
        {
                await ChartSettings.RemoveChartAsync(SessionState.SelectedConnection.Id, config.Id);
            StateHasChanged();
        }
    }

    public ValueTask DisposeAsync()
    {
        ChartSettings.ChartsChanged -= OnConfigurationsChanged;
        SessionState.SelectedConnectionChanged -= OnSelectedConnectionChanged;
        return ValueTask.CompletedTask;
    }
}
