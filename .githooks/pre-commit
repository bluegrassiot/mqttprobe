#!/usr/bin/env bash
set -euo pipefail

HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib.sh
source "$HOOK_DIR/lib.sh"

ROOT="$(hook_root)"
cd "$ROOT"

if env_truthy "${SKIP_PRE_COMMIT:-}"; then
    step "pre-commit"
    skip_msg "SKIP_PRE_COMMIT set"
    print_total
    exit 0
fi

step "Classify staged files"
STAGED=$(git diff --cached --name-only --diff-filter=ACMR || true)
if [[ -z "${STAGED//[$'\t\r\n']/}" ]]; then
    skip_msg "no staged files"
    print_total
    exit 0
fi

pass "Classify staged files"

# Runs for every staged change, docs included: devskim scans all file types, and a
# pasted token in a README is exactly what it is for. Whole-tree scan, ~3s.
step "Security scan"
if ! SCAN_OUT=$(python "$ROOT/scripts/ci/inspect.py" --tool devskim --fail-on warning \
        -o "$ROOT/artifacts/inspect-precommit.md" 2>&1); then
    fail "Security scan"
    printf '%s\n' "$SCAN_OUT"
    printf "\nFalse positive? Put a 'DevSkim: ignore DS######' comment on the flagged line.\n"
    print_total
    exit 1
fi
pass "Security scan"

step "Workflow lint"
if ! printf '%s\n' "$STAGED" | any_workflow_relevant; then
    skip_msg "no staged workflow files"
# scripts/ci/actionlint.py picks a local binary over its Docker fallback. Neither is a
# dotnet tool we restore, so skip rather than block a contributor who has neither.
elif ! command -v actionlint >/dev/null 2>&1 && ! command -v docker >/dev/null 2>&1; then
    skip_msg "no actionlint or docker (see scripts/ci/actionlint.py)"
else
    if ! LINT_OUT=$(python "$ROOT/scripts/ci/actionlint.py" 2>&1); then
        fail "Workflow lint"
        printf '%s\n' "$LINT_OUT"
        printf "\nIf Docker is not running, start it or use: SKIP_PRE_COMMIT=1 git commit ...\n"
        print_total
        exit 1
    fi
    pass "Workflow lint"
fi

step "Format"
if ! printf '%s\n' "$STAGED" | any_format_relevant; then
    skip_msg "no format-relevant staged files"
else
    if ! python "$ROOT/scripts/ci/format-check.py"; then
        fail "Format"
        printf "\nFormatting violations found - run: python scripts/ci/format-check.py --fix\n"
        print_total
        exit 1
    fi
    pass "Format"
fi

step "File length"
if ! printf '%s\n' "$STAGED" | any_file_length_relevant; then
    skip_msg "no file-length-relevant staged files"
else
    if ! python "$ROOT/scripts/ci/check-file-length.py" --staged; then
        fail "File length"
        print_total
        exit 1
    fi
    pass "File length"
fi

# Scans the whole src+tests tree rather than staged paths: a new blocking call site
# is only unsafe in combination with the chain it blocks on, which may be untouched.
step "Blocking awaits"
if ! printf '%s\n' "$STAGED" | any_file_length_relevant; then
    skip_msg "no C#/Razor staged files"
else
    if ! python "$ROOT/scripts/ci/check-blocking-awaits.py"; then
        fail "Blocking awaits"
        print_total
        exit 1
    fi
    pass "Blocking awaits"
fi

# Enforces AGENTS.md ban on routine XML doc comments. Whole-tree scan like blocking awaits.
step "Comments"
if ! printf '%s\n' "$STAGED" | any_comment_check_relevant; then
    skip_msg "no C#/Razor staged files"
else
    if ! python "$ROOT/scripts/ci/check-comments.py"; then
        fail "Comments"
        print_total
        exit 1
    fi
    pass "Comments"
fi

printf "\n${GREEN}pre-commit checks passed.${RESET}\n"
print_total