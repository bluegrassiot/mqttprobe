<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>__MAUI_DEFAULT_SCENE_CONFIGURATION__</string>
					<key>UISceneDelegateClassName</key>
					<string>SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>XSAppIconAssets</key>
	<string>Assets.xcassets/appicon.appiconset</string>
	<!-- No NSBonjourServices: brokers are user-entered, never discovered. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>MQTTProbe connects to the MQTT broker you specify, which is typically on your local network.</string>
	<!-- ws:// to LAN brokers only; raw MQTT over TCP is a BSD socket outside ATS.
	     Remote hosts keep full TLS enforcement. Verify ws:// on a real device. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- CFBundleShortVersionString/CFBundleVersion are deliberately absent: the build sets
	     them from ApplicationDisplayVersion/ApplicationVersion, but only via SetIfNotPresent,
	     so a value here would win and pin every release to it. -->
	<!-- Export compliance: TLS/mTLS to brokers and AES-256-GCM at rest in the client-certificate
	     store are standard platform APIs. Matches MacCatalyst; technical description, not a
	     legal determination. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
