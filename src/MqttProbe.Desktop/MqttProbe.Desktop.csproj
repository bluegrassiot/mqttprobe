<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>MqttProbe</RootNamespace>
        <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
        <Version>0.0.0</Version>
    </PropertyGroup>

    <ItemGroup>
        <!-- Photino.Blazor 4.0.13 only includes Microsoft.AspNetCore.Components.WebView
             for net8.0/net9.0 dependency groups. Explicitly add it for net10.0 so the
             _framework/blazor.webview.js static web asset is processed at build time. -->
        <PackageReference Include="Meziantou.Analyzer">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
        <PackageReference Include="SonarAnalyzer.CSharp">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="System.Security.Cryptography.ProtectedData" />
        <PackageReference Include="Photino.Blazor" />
        <PackageReference Include="Velopack" />
    </ItemGroup>

    <ItemGroup>
        <Content Update="wwwroot\**">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <Content Include="Assets\**">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\MqttProbe.Core\MqttProbe.Core.csproj" />
        <ProjectReference Include="..\MqttProbe.UI\MqttProbe.UI.csproj" />
    </ItemGroup>

    <!-- Photino serves the UI from a PhysicalFileProvider rooted at the output wwwroot and
         never reads the static web assets manifests, so RCL assets (_content/**), the scoped
         CSS bundle and _framework/blazor.webview.js have to exist on disk. The SDK only
         materializes those on publish, so a built-and-run app got a 404 for every one of them
         and rendered an empty window. Mirror the publish layout into the build output; the
         MAUI BlazorWebView SDK solves the same problem the same way in
         ConvertStaticWebAssetsToMauiAssets. -->
    <Target Name="CopyStaticWebAssetsToPhotinoRoot"
            AfterTargets="Build"
            DependsOnTargets="StaticWebAssetsPrepareForRun">
        <ComputeStaticWebAssetsTargetPaths Assets="@(StaticWebAsset)" PathPrefix="wwwroot">
            <Output TaskParameter="AssetsWithTargetPath" ItemName="_PhotinoStaticWebAsset" />
        </ComputeStaticWebAssetsTargetPaths>

        <Copy SourceFiles="@(_PhotinoStaticWebAsset)"
              DestinationFiles="@(_PhotinoStaticWebAsset->'$(OutDir)%(TargetPath)')"
              SkipUnchangedFiles="true">
            <Output TaskParameter="DestinationFiles" ItemName="FileWrites" />
        </Copy>
    </Target>

    <ItemGroup>
        <InternalsVisibleTo Include="MqttProbe.UI.Tests" />
    </ItemGroup>

</Project>
