@inject IMessageStoreManager MessageStoreManager
@implements IAsyncDisposable

<div class="mobile-topic-bar">
    <div class="mobile-topic-bar__info" role="button" tabindex="0"
         aria-label="@InfoLabel" aria-disabled="@(HasTopics ? null : "true")"
         @onclick="OpenPicker" @onkeydown="HandleInfoKeyDown">
        @if (BulkSelection is { IsActive: true })
        {
            <MudIcon Icon="@LucideIcons.CheckCircle" Size="Size.Small" Color="Color.Primary" Class="mr-1"/>
            <span class="mobile-topic-bar__name mobile-topic-bar__name--selection">@BulkSelection.Summary</span>
        }
        else if (_selectedTopic is not null)
        {
            <MudIcon Icon="@LucideIcons.Layers" Size="Size.Small" Color="Color.Primary" Class="mr-1"/>
            <span class="mobile-topic-bar__name" title="@_selectedTopic">@_selectedTopic</span>
            @if (_messageCount > 0)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                         Class="mobile-topic-bar__count-chip">
                    @_messageCount
                </MudChip>
            }
        }
        else
        {
            <MudIcon Icon="@LucideIcons.Layers" Size="Size.Small" Color="Color.Secondary" Class="mr-1"/>
            <span class="mobile-topic-bar__name mobile-topic-bar__name--empty">Choose a topic</span>
        }
    </div>
    <AppSecondaryButton Size="Size.Small"
                        StartIcon="@LucideIcons.CheckCircle"
                        OnClick="StartSelecting"
                        Disabled="@(!HasTopics)"
                        Class="mobile-topic-bar__select">
        Select
    </AppSecondaryButton>
    <AppPrimaryButton Size="Size.Small"
                StartIcon="@LucideIcons.ChevronDown"
                OnClick="OpenPicker"
                Disabled="@(!HasTopics)"
                Class="mobile-topic-bar__btn">
        Topics
    </AppPrimaryButton>
</div>

@code {
    [Parameter] public bool HasTopics { get; set; }
    [Parameter] public EventCallback OnOpenPicker { get; set; }
    [Parameter] public EventCallback OnSelectTopics { get; set; }

    [CascadingParameter] private TopicBulkSelection? BulkSelection { get; set; }

    private string? _selectedTopic;
    private int _messageCount;
    private Timer? _updateTimer;
    private bool _disposed;

    private string InfoLabel
    {
        get
        {
            if (BulkSelection is { IsActive: true } bulk)
                return $"Change topics, {bulk.Summary}";

            return _selectedTopic is null ? "Choose a topic" : $"Change topic, current topic {_selectedTopic}";
        }
    }

    private async Task HandleInfoKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is not ("Enter" or " "))
            return;
        if (e.CtrlKey || e.AltKey || e.MetaKey)
            return;

        await OpenPicker();
    }

    protected override void OnInitialized()
    {
        SyncFromManager();
        if (BulkSelection is not null)
            BulkSelection.Changed += OnBulkSelectionChanged;
        _updateTimer = new Timer(async _ =>
        {
            if (_disposed) return;
            SyncFromManager();
            await RequestRenderSafelyAsync();
        }, null, 0, 1_000);
    }

    private void OnBulkSelectionChanged() => _ = RequestRenderSafelyAsync();

    private async Task RequestRenderSafelyAsync()
    {
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException) when (_disposed)
        {
            // Circuit was torn down between timer tick and dispatch.
        }
    }

    private void SyncFromManager()
    {
        var state = MessageStoreManager.GetSelectedTopicState();
        _selectedTopic = state.Label ?? state.Key;
        _messageCount = state.MessageCount;
    }

    private async Task OpenPicker()
    {
        if (!HasTopics) return;
        await OnOpenPicker.InvokeAsync();
    }

    private async Task StartSelecting()
    {
        if (!HasTopics) return;
        await OnSelectTopics.InvokeAsync();
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (BulkSelection is not null)
            BulkSelection.Changed -= OnBulkSelectionChanged;
        if (_updateTimer != null)
            await _updateTimer.DisposeAsync();
    }
}
