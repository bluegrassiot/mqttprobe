<MudGrid Spacing="2" Class="mt-2">
    <MudItem xs="12" sm="6">
        <MudTextField Variant="Variant.Outlined" @bind-Value="Connection.Name"
                      For="@(() => Connection.Name)" Immediate="true" Label="Name" />
    </MudItem>
    <MudItem xs="12" sm="6">
        <MudTextField Variant="Variant.Outlined" @bind-Value="Connection.ClientId"
                      For="@(() => Connection.ClientId)" Immediate="true" Label="Client ID" />
    </MudItem>
    <MudItem xs="12">
        <MudStack Spacing="2">
            <MudCheckBox @bind-Value="@Connection.CleanStart" Color="Color.Default">
                @(Connection.MqttVersion == MqttVersion.V5 ? "Clean start" : "Clean session")
            </MudCheckBox>
            @if (Connection is { CleanStart: false, MqttVersion: MqttVersion.V5 })
            {
                <MudTextField Variant="Variant.Outlined"
                              @bind-Value="Connection.SessionExpiryIntervalSeconds"
                              For="@(() => Connection.SessionExpiryIntervalSeconds)"
                              Immediate="true" Label="Session expiry interval (s)"
                              HelperText="0 ends the session when the connection closes." />
            }
        </MudStack>
    </MudItem>
</MudGrid>

@code {
    [Parameter, EditorRequired] public Connection Connection { get; set; } = null!;
}
