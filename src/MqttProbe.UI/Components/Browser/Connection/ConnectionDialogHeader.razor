<div class="connection-dialog-header">
    <div class="connection-dialog-header__main">
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="header-label">Connection:</MudText>
        <MudSelect T="Connection?"
                   Value="@Selected"
                   ValueChanged="@OnSelectedChanged"
                   Placeholder="Select a saved connection..."
                   ToStringFunc="@(c => c?.Name ?? string.Empty)"
                   Dense="true"
                   Margin="Margin.Dense"
                   Variant="Variant.Outlined"
                   Class="connection-dialog-selector"
                   aria-label="Saved connection"
                   data-testid="saved-connection"
                   @key="SelectorKey">
            @foreach (var connection in Connections)
            {
                <MudSelectItem T="Connection?" Value="@((Connection?)connection)">@connection.Name</MudSelectItem>
            }
        </MudSelect>
        <div class="connection-dialog-header__action">
            @if (IsConnecting)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@LucideIcons.Square"
                           data-testid="cancel-connect"
                           OnClick="@(async () => await OnStop.InvokeAsync())">Stop</MudButton>
            }
            else
            {
                <AppPrimaryButton title="Connect" MinWidth="true" StartIcon="@LucideIcons.Power"
                                  Class="connection-dialog-connect" data-testid="connection-connect"
                                  Disabled="@ConnectDisabled"
                                  OnClick="@(async () => await OnConnect.InvokeAsync())">Connect</AppPrimaryButton>
            }
        </div>
    </div>
    <div class="connection-dialog-header__secondary">
        @if (IsConnecting)
        {
            <div class="connection-connecting-status" data-testid="connection-connecting-status" role="status">
                <img class="signal-connecting-sm" width="26" height="26" src="/_content/MqttProbe.UI/img/signal-motif.svg" alt="" />
                <MudText Typo="Typo.body2">Connecting...</MudText>
            </div>
        }
        <div class="connection-dialog-actions">
            <MudIconButton Icon="@LucideIcons.Plus" Color="Color.Inherit" Size="Size.Medium"
                           title="New connection" OnClick="@(async () => await OnAdd.InvokeAsync())" />
            <MudIconButton Icon="@LucideIcons.Copy" Color="Color.Inherit" Size="Size.Medium"
                           title="Copy connection" Disabled="@(!CanCopy)"
                           OnClick="@(async () => await OnCopy.InvokeAsync())" />
            <MudIconButton Icon="@LucideIcons.Save" Color="Color.Inherit" Size="Size.Medium"
                           title="Save connection" Disabled="@(!CanSave)"
                           OnClick="@(async () => await OnSave.InvokeAsync())" />
            <MudIconButton Icon="@LucideIcons.Trash2" Color="Color.Error" Size="Size.Medium"
                           title="Delete connection" Disabled="@(!CanDelete)"
                           OnClick="@(async () => await OnDelete.InvokeAsync())" />
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<Connection> Connections { get; set; } = [];
    [Parameter] public Connection? Selected { get; set; }
    [Parameter] public EventCallback<Connection?> SelectedChanged { get; set; }
    [Parameter] public bool CanSave { get; set; }
    [Parameter] public bool CanCopy { get; set; }
    [Parameter] public bool CanDelete { get; set; }
    [Parameter] public bool IsConnecting { get; set; }
    [Parameter] public bool ConnectDisabled { get; set; }
    [Parameter] public object? SelectorKey { get; set; }
    [Parameter] public EventCallback OnAdd { get; set; }
    [Parameter] public EventCallback OnCopy { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }
    [Parameter] public EventCallback OnConnect { get; set; }
    [Parameter] public EventCallback OnStop { get; set; }

    private async Task OnSelectedChanged(Connection? value)
    {
        if (value is not null)
            await SelectedChanged.InvokeAsync(value);
    }
}
