@using Microsoft.AspNetCore.Components.Authorization
@using MqttProbe.UI.Components.Layout
@using MqttProbe.Web.Components

<CascadingAuthenticationState>
    <ForceLoginNotifier />
    <Router AppAssembly="@typeof(App).Assembly"
            AdditionalAssemblies="[typeof(MqttProbe.UI.Components.Pages.Index).Assembly]">
        <Found Context="routeData">
            <AuthRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized Context="authState">
                    @{
                        var signedOut = authState.User.Identity?.IsAuthenticated != true;
                    }
                    <PageTitle>@(signedOut ? "Sign in required" : "Access denied")</PageTitle>
                    <main class="auth-state">
                        <div class="auth-state__card">
                            <p class="auth-state__brand">
                                <img src="/favicon.svg" width="34" height="34" alt="" aria-hidden="true" />
                                <span class="auth-state__brand-mqtt">MQTT</span><span class="auth-state__brand-probe">Probe</span>
                            </p>
                            <h1 class="auth-state__title">@(signedOut ? "You're signed out" : "Access denied")</h1>
                            <p class="auth-state__text">
                                @(signedOut
                                    ? "Your session has ended. Sign in to continue."
                                    : "Your account doesn't have permission to view this page.")
                            </p>
                            @if (signedOut)
                            {
                                <a class="auth-state__action auth-state__action--primary" href="/Login" data-enhance-nav="false">Sign in</a>
                            }
                            else
                            {
                                <a class="auth-state__action" href="/">Back to home</a>
                            }
                        </div>
                    </main>
                </NotAuthorized>
            </AuthRouteView>
        </Found>
        <NotFound>
            <PageTitle>Page not found</PageTitle>
            <main class="auth-state">
                <div class="auth-state__card">
                    <p class="auth-state__brand">
                        <img src="/favicon.svg" width="34" height="34" alt="" aria-hidden="true" />
                        <span class="auth-state__brand-mqtt">MQTT</span><span class="auth-state__brand-probe">Probe</span>
                    </p>
                    <h1 class="auth-state__title">Page not found</h1>
                    <p class="auth-state__text">Sorry, there's nothing at this address.</p>
                    <a class="auth-state__action auth-state__action--primary" href="/">Back to home</a>
                </div>
            </main>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
