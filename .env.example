# Copy to .env and set the hostname or IP that browsers use to reach MQTT Probe.
# It drives host filtering (AllowedHosts) in both docker-compose.yml and
# docker-compose.prod.yml, and additionally the TLS certificate (caddy) in the
# prod file. A mismatch produces 400 Bad Request - Invalid Hostname.
# Examples:
#   MQTTPROBE_HOST=192.168.1.50
#   MQTTPROBE_HOST=mqttprobe.lan
MQTTPROBE_HOST=localhost
