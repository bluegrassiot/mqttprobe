@using Microsoft.Extensions.Logging
@using MudBlazor.Utilities
@using MqttProbe.Core.Services.Configuration
@using MqttProbe.Core.Services.Security
@implements IAsyncDisposable
@inject IMessageStoreManager MessageStoreManagerService
@inject IMqttManagedClient ManagedMqttClient
@inject IConnectionSettings ConnectionSettings
@inject IUiSettings UiSettings
@inject ILogger<ConnectionDialog> Logger
@inject ISessionState SessionState
@inject ISubscriptionManager SubscriptionManager
@inject ITopicExcludeService TopicExcludeService
@inject IMqttOptionsBuilder MqttOptionsBuilder
@inject IChartDataService ChartDataService
@inject IBrokerStateResetCoordinator BrokerResetCoordinator
@inject IUxMetricsService? UxMetrics
@inject IDialogService DialogService
@inject IConnectionSessionLifecycle SessionLifecycle
@inject ICertificateAssetStore CertStore
@inject ISnackbar Snackbar
<MudDialog OnBackdropClick="OnBackdropClickAsync">
    <DialogContent>
        <div class="connection-dialog-content" @onkeydown="HandleDialogKeyDown" tabindex="-1">
            <ConnectionDialogHeader Connections="@ConnectionSettings.Connections"
                                     Selected="@_savedConnectionForSelector"
                                     SelectedChanged="ConnectionChanged!"
                                     SelectorKey="@_selectorGeneration"
                                     CanSave="@_canSave"
                                    CanCopy="@(!string.IsNullOrWhiteSpace(_selectedConnection.Name))"
                                    CanDelete="@_canDelete"
                                    OnAdd="@(async () => await Add())"
                                    OnCopy="@(async () => await CopyConnection())"
                                    OnSave="@(async () => await Save(closeDialog: false))"
                                    OnDelete="@(async () => await Delete())" />
            <MudForm Model="@_selectedConnection" @ref="@_form"
                     Validation="@_connectionValidator.ValidateValue" ValidationDelay="0"
                     IsValidChanged="@FormValidationChanged" FieldChanged="@FormChanged">
                <div class="step-selector">
                    <button class="step-btn @(_activeTabIndex == 0 ? "active" : "")"
                            @onclick="() => _activeTabIndex = 0" type="button">Connection</button>
                    <button class="step-btn @(_activeTabIndex == 1 ? "active" : "")"
                            @onclick="() => _activeTabIndex = 1" type="button">Security</button>
                    <button class="step-btn @(_activeTabIndex == 2 ? "active" : "")"
                            @onclick="() => _activeTabIndex = 2" type="button">On Connect</button>
                </div>
                <MudTabs @bind-ActivePanelIndex="_activeTabIndex"
                         KeepPanelsAlive="true" Elevation="0" Class="connection-tabs">
                    <MudTabPanel Text="Connection">
                        <ConnectionFields Connection="@_selectedConnection" OnConnectionEdited="UpdateActionStates" />
                    </MudTabPanel>
                    <MudTabPanel Text="Security">
                        <ConnectionSecurityFields Connection="@_selectedConnection" />
                        <ConnectionCertificateSection @ref="_certSection"
                                                       Connection="@_selectedConnection"
                                                       Visible="_selectedConnection.UseTls"
                                                       OnStateChanged="UpdateActionStates"
                                                       OnStagedAssetCleanupRequested="HandleCertStagedAssetCleanup"
                                                       OnRevertRequested="HandleCertRevert" />
                    </MudTabPanel>
                    <MudTabPanel Text="On Connect">
                        <ConnectionOnConnectTab AutoResubscribe="@UiSettings.Ui.AutoResubscribe"
                                                AutoResubscribeChanged="@OnAutoResubscribeChanged"
                                                Items="@_selectedConnection.SubscribedTopics"
                                                OnAdd="HandleOnConnectEditorAdd"
                                                OnRemove="HandleOnConnectEditorRemove"
                                                ExcludedItems="@_selectedConnection.TopicExcludes"
                                                OnExcludeAdd="HandleOnConnectExcludeAdd"
                                                OnExcludeRemove="HandleOnConnectExcludeRemove" />
                    </MudTabPanel>
                </MudTabs>
                <div class="connection-actions-footer">
                    @if (_nameCollisionError is not null)
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" Variant="Variant.Outlined" Class="mb-1">
                            @_nameCollisionError
                        </MudAlert>
                    }
                    @if (_connectionState == ConnectionState.Connecting)
                    {
                        <div class="d-flex align-center gap-2">
                            <img class="signal-connecting-sm" width="26" height="26" src="/_content/MqttProbe.UI/img/signal-motif.svg" alt="" />
                            <MudText Typo="Typo.subtitle1">Connecting...</MudText>
                        </div>
                    }
                    else
                    {
                        <div class="connection-actions-footer-cta">
                            <MudButton Variant="Variant.Text" OnClick="@(async () => await RequestClose())"
                                       Class="mr-2">Cancel</MudButton>
                            <AppPrimaryButton title="Connect" MinWidth="true"
                                        StartIcon="@LucideIcons.Power" Disabled="@(!_canConnect)"
                                        OnClick="@(async () => await Connect())">Connect</AppPrimaryButton>
                        </div>
                    }
                    @if (_connectionState == ConnectionState.Failed)
                    {
                        <MudAlert Class="mt-2" Severity="Severity.Error" Variant="Variant.Outlined">
                            Connection failed. Verify broker, credentials, and transport settings.
                        </MudAlert>
                    }
                </div>
            </MudForm>
        </div>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] public required IMudDialogInstance MudDialog { get; set; }
    [Parameter] public EventCallback<bool> OnComplete { get; set; }

    private MudForm _form = new();
    private readonly ConnectionValidator _connectionValidator = new();
    private ConnectionState _connectionState;
    private Connection? _savedConnectionForSelector;
    private Connection _selectedConnection = new();
    private bool _canConnect, _canSave, _canDelete, _isFormValid, _formReportsValid = true;
    private int _activeTabIndex;
    private CertificateSessionResource? _activeCertResource;
    private string? _stagedAssetId;
    private Guid _stagedAssetOwnerId;
    private ConnectionCertificateSection? _certSection;

    private Connection? _pendingAttemptConnection;
    private Connection? _pendingAttemptSavedSelector;

    private Connection _baselineConnection = new();
    private bool _baselineCertHadPendingChange;
    private string? _baselineStagedAssetId;
    private string? _nameCollisionError;
    private int _selectorGeneration;

    internal Connection SelectedConnectionForTests => _selectedConnection;
    internal Connection? SavedConnectionForSelectorTests => _savedConnectionForSelector;
    internal int ActiveTabIndexForTests => _activeTabIndex;
    internal string? NameCollisionErrorForTests => _nameCollisionError;

    internal void SetStagedCertificate(byte[]? pfxBytes, byte[]? pemCertBytes, byte[]? pemKeyBytes, string password)
    {
        if (_certSection is not null)
        {
            _certSection.SetStagedCertificate(pfxBytes, pemCertBytes, pemKeyBytes, password);
            UpdateActionStates();
            StateHasChanged();
        }
    }

    public void FormValidationChanged(bool isValid)
    {
        _formReportsValid = isValid;
        UpdateActionStates();
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        ManagedMqttClient.ConnectingFailedAsync += OnConnectingFailed;
        ManagedMqttClient.ConnectedAsync += OnConnected;

        var preselected = false;
        if (SessionState.LastSuccessfulConnectionId is { } lastId)
        {
            var saved = ConnectionSettings.Connections.FirstOrDefault(c => c.Id == lastId);
            if (saved is not null)
            {
                _savedConnectionForSelector = saved;
                _selectedConnection = saved.Clone();
                _canDelete = true;
                preselected = true;
            }
        }

        if (!preselected && SessionState.LastSuccessfulConnectionSnapshot is { } snapshot)
        {
            _savedConnectionForSelector = null;
            _selectedConnection = new Connection
            {
                Id = snapshot.Id,
                Name = snapshot.Name,
                Host = snapshot.Host,
                Port = snapshot.Port,
                User = snapshot.User,
                Password = snapshot.Password,
                Protocol = snapshot.Protocol,
                MqttVersion = snapshot.MqttVersion,
                ClientId = snapshot.ClientId,
                WebsocketBasePath = snapshot.WebsocketBasePath,
                UseTls = snapshot.UseTls,
                AllowUntrustedCertificate = snapshot.AllowUntrustedCertificate,
                ClientCertificateAssetId = snapshot.ClientCertificateAssetId,
                ConnectTimeout = snapshot.ConnectTimeout,
                ReconnectDelay = snapshot.ReconnectDelay,
                KeepAlivePeriod = snapshot.KeepAlivePeriod,
                CleanStart = snapshot.CleanStart,
                SessionExpiryIntervalSeconds = snapshot.SessionExpiryIntervalSeconds,
                SubscribedTopics = snapshot.SubscribedTopics.Select(t => new SubscribedTopic { Topic = t.Topic, QualityOfServiceLevel = t.QualityOfServiceLevel }).ToList(),
                TopicExcludes = [.. snapshot.TopicExcludes]
            };
            _canDelete = false;
            preselected = true;
        }

        if (preselected)
            await InitializePreselectedConnection();

        CaptureBaseline();
        _initializedPreselection = preselected;
        await base.OnInitializedAsync();
    }

    private bool _initializedPreselection;
    private bool _preselectionCertInitialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _initializedPreselection && !_preselectionCertInitialized)
        {
            _preselectionCertInitialized = true;
            await InitializePreselectedCert();
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task InitializePreselectedConnection()
    {
        UpdateActionStates();
    }

    private async Task InitializePreselectedCert()
    {
        var previousAssetId = _selectedConnection.ClientCertificateAssetId;
        var unavailable = false;
        string? certError = null;
        if (previousAssetId is not null)
        {
            var bundle = await CertStore.LoadAsync(_selectedConnection.Id, previousAssetId);
            if (bundle is null)
            {
                certError = "The configured client certificate is unavailable or corrupt. " +
                    "Re-import the certificate or remove it from the connection settings.";
                unavailable = true;
            }
            else { bundle.Certificate.Dispose(); }
        }
        _certSection?.ResetForConnection(previousAssetId, unavailable, certError);
        CaptureBaseline();
        UpdateActionStates();
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        ManagedMqttClient.ConnectingFailedAsync -= OnConnectingFailed;
        ManagedMqttClient.ConnectedAsync -= OnConnected;
        if (_activeCertResource is not null)
        {
            _activeCertResource.Dispose();
            _activeCertResource = null;
        }
        if (_stagedAssetId is not null)
        {
            try { await CertStore.DeleteAsync(_stagedAssetOwnerId, _stagedAssetId); } catch { /* unreferenced staged asset */ }
            _stagedAssetId = null;
        }
    }

    private void CaptureBaseline()
    {
        _baselineConnection = _selectedConnection.Clone();
        _baselineCertHadPendingChange = HasPendingCertificateChange();
        _baselineStagedAssetId = _stagedAssetId;
    }

    private bool IsDirty =>
        !_baselineConnection.Equals(_selectedConnection) ||
        !_baselineConnection.SubscribedTopics
            .Select(t => (t.Topic, t.QualityOfServiceLevel))
            .SequenceEqual(_selectedConnection.SubscribedTopics
                .Select(t => (t.Topic, t.QualityOfServiceLevel))) ||
        HasPendingCertificateChange() != _baselineCertHadPendingChange ||
        _stagedAssetId != _baselineStagedAssetId;

    private void CheckNameUniqueness()
    {
        var trimmed = _selectedConnection.Name.Trim();
        if (string.IsNullOrWhiteSpace(trimmed))
        {
            _nameCollisionError = null;
            return;
        }

        if (!IsDirty)
        {
            _nameCollisionError = null;
            return;
        }

        var selfId = _selectedConnection.Id;
        var collision = ConnectionSettings.Connections.Any(c =>
            c.Id != selfId &&
            string.Equals(c.Name.Trim(), trimmed, StringComparison.OrdinalIgnoreCase));

        _nameCollisionError = collision
            ? $"A connection named \"{trimmed}\" already exists."
            : null;
    }

    private async Task<bool> GuardIfDirty()
    {
        if (!IsDirty) return true;

        var options = new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true };
        var choice = await DialogService.ShowMessageBoxAsync(
            "Unsaved changes",
            "You have unsaved changes that will be discarded.",
            yesText: "Discard", noText: "Cancel", options: options);

        return choice is true;
    }

    private async Task RequestClose()
    {
        if (await GuardIfDirty())
            MudDialog.Cancel();
    }

    private async Task OnBackdropClickAsync()
    {
        await RequestClose();
    }

    private async Task HandleDialogKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            await RequestClose();
    }

    private void FormChanged(FormFieldChangedEventArgs args)
    {
        UpdateActionStates();
    }

    private void UpdateActionStates()
    {
        _isFormValid = _formReportsValid && _connectionValidator.Validate(_selectedConnection).IsValid;
        _canConnect = _isFormValid;
        CheckNameUniqueness();
        UpdateCanSave();
        StateHasChanged();
    }

    private void UpdateCanSave()
    {
        var matchesSaved = ConnectionSettings.Connections.Any(conn => conn.Equals(_selectedConnection));
        _canSave = (!matchesSaved || HasPendingCertificateChange()) && _isFormValid && _nameCollisionError is null;
    }

    private bool HasPendingCertificateChange() =>
        (_certSection?.HasPendingChange ?? false) || _stagedAssetId is not null;

    private async Task<bool> ValidateForm()
    {
        await _form.ValidateAsync();
        return _form.IsValid;
    }

    internal bool ValidateModelOnly() =>
        _connectionValidator.Validate(_selectedConnection).IsValid;
}
