@using AppChartType = MqttProbe.Core.Models.Chart.ChartType
<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@LucideIcons.Activity" Class="mr-2"/>
            @(Configuration == null ? "New Chart" : "Edit Chart")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField @bind-Value="_name" Label="Chart Name" Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true" Required="true" MaxLength="100" />
            <MudSelect @bind-Value="_type" Label="Chart Type" Variant="Variant.Outlined" Margin="Margin.Dense">
                @foreach (AppChartType t in Enum.GetValues<AppChartType>())
                {
                    <MudSelectItem Value="@t">@t</MudSelectItem>
                }
            </MudSelect>
            <MudNumericField @bind-Value="_maxPoints" Label="Max Points Per Series"
                             Variant="Variant.Outlined" Margin="Margin.Dense" Min="10" Max="5000" Step="100" />
            <MudSelect @bind-Value="_timeWindow" Label="Time Window" Variant="Variant.Outlined"
                       Margin="Margin.Dense" Clearable="true">
                <MudSelectItem Value="@((int?)5)">Last 5 minutes</MudSelectItem>
                <MudSelectItem Value="@((int?)10)">Last 10 minutes</MudSelectItem>
                <MudSelectItem Value="@((int?)30)">Last 30 minutes</MudSelectItem>
                <MudSelectItem Value="@((int?)60)">Last 1 hour</MudSelectItem>
                <MudSelectItem Value="@((int?)null)">All retained points</MudSelectItem>
            </MudSelect>
            <div class="chart-dialog-timeout-row">
                <MudNumericField @bind-Value="_staleTimeoutSeconds"
                                 Label="Stale timeout (seconds)"
                                 Variant="Variant.Outlined" Margin="Margin.Dense"
                                 Min="0" Step="1" Disabled="_staleTimeoutOff"
                                 Error="@(!StaleTimeoutValid)"
                                 HelperText="A series turns stale when its last point is older than this."
                                 Class="chart-dialog-timeout" />
                <MudSwitch T="bool" @bind-Value="_staleTimeoutOff" Label="Off"
                           Color="Color.Primary" />
                @if (!StaleTimeoutValid)
                {
                    <MudText Typo="Typo.caption" Color="Color.Error" Class="chart-dialog-timeout-error">
                        Enter a timeout greater than zero seconds.
                    </MudText>
                }
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="chart-dialog-timeout-note">
                    Choose Off for topics that publish only when a value changes.
                </MudText>
            </div>

            <MudDivider />
            <MudText Typo="Typo.subtitle2">Series review (@_series.Count selected)</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                Confirm display names and field mappings before saving.
            </MudText>

            @foreach (var series in _series)
            {
                var s = series;
                <MudPaper Elevation="0" Class="pa-2 app-chrome-panel chart-dialog-series">
                    <div class="d-flex align-center gap-2">
                        <span class="chart-dialog-series-swatch" style="background:@s.Color"></span>
                        <div class="flex-grow-1">
                            <MudTextField @bind-Value="s.DisplayName" Variant="Variant.Text"
                                          Margin="Margin.Dense" Immediate="true"
                                          Placeholder="Series name" Class="chart-dialog-series-name"/>
                            <MudText Typo="Typo.caption" Color="Color.Secondary"
                                     Class="app-mono">
                                @s.Topic › @s.JsonPath
                            </MudText>
                        </div>
                        <MudIconButton Icon="@LucideIcons.Trash2" Size="Size.Small"
                                       Color="Color.Error" title="Remove series"
                                       OnClick="() => _series.Remove(s)" />
                    </div>
                </MudPaper>
            }

            @if (!_series.Any())
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="text-center pa-2">
                    No series yet. Open a JSON message in the Browser tab and click a field to add it here.
                </MudText>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <AppTertiaryButton MinWidth="true" OnClick="Cancel">Cancel</AppTertiaryButton>
        <AppPrimaryButton MinWidth="true"
                   Disabled="@(string.IsNullOrWhiteSpace(_name) || !StaleTimeoutValid)"
                   OnClick="Submit">
            @(Configuration == null ? "Create Chart" : "Save Chart")
        </AppPrimaryButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public ChartConfiguration? Configuration { get; set; }

    private string _name = "";
    private AppChartType _type = AppChartType.Line;
    private int _maxPoints = 500;
    private int? _timeWindow;
    private double? _staleTimeoutSeconds = ChartConfiguration.DefaultStaleTimeoutSeconds;
    private bool _staleTimeoutOff;
    private List<ChartSeries> _series = [];

    private bool StaleTimeoutValid => _staleTimeoutOff
        || (_staleTimeoutSeconds is { } seconds && ChartFreshnessEvaluator.IsValidTimeout(seconds));

    protected override void OnParametersSet()
    {
        if (Configuration != null)
        {
            _name = Configuration.Name;
            _type = Configuration.Type;
            _maxPoints = Configuration.MaxPoints;
            _timeWindow = Configuration.TimeWindowMinutes;
            _staleTimeoutSeconds = Configuration.StaleTimeoutSeconds ?? ChartConfiguration.DefaultStaleTimeoutSeconds;
            _staleTimeoutOff = Configuration.StaleTimeoutSeconds is null;
            _series = [.. Configuration.Series.Select(s => new ChartSeries
            {
                Id = s.Id,
                DisplayName = s.DisplayName,
                Topic = s.Topic,
                JsonPath = s.JsonPath,
                Color = s.Color
            })];
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private void Submit()
    {
        if (!StaleTimeoutValid) return;

        var config = new ChartConfiguration
        {
            Name = _name,
            Type = _type,
            MaxPoints = _maxPoints,
            TimeWindowMinutes = _timeWindow,
            StaleTimeoutSeconds = _staleTimeoutOff ? null : _staleTimeoutSeconds,
            Series = _series
        };
        if (Configuration != null)
            config.Id = Configuration.Id;
        MudDialog.Close(DialogResult.Ok(config));
    }
}
