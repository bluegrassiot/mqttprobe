# Authentik OIDC lab environment.
# Copy to .env and fill in real values. The .env file is gitignored.

# Authentik secret key (cookie signing). Generate with:
#   openssl rand -base64 60 | tr -d '\n'
AUTHENTIK_SECRET_KEY=CHANGE_ME

# PostgreSQL password. Generate with:
#   openssl rand -base64 36 | tr -d '\n'
PG_PASS=CHANGE_ME

# Bootstrap password for the akadmin user (first start only).
AUTHENTIK_BOOTSTRAP_PASSWORD=CHANGE_ME

# Client secret for the mqttprobe OAuth2 provider.
# Must match Authentication__Oidc__ClientSecret when running mqttprobe.
# Generate with:
#   openssl rand -base64 36 | tr -d '\n'
MQTT_PROBE_CLIENT_SECRET=CHANGE_ME
