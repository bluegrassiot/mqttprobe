@namespace MqttProbe.UI.Components.Settings
@inject IAppInfoService AppInfoService
@inject IUpdateService UpdateService

<MudText Typo="Typo.body2" Color="Color.Secondary">
    MQTTProbe — the MQTT diagnostic tool built for IIoT.
</MudText>
<MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
    Version @_version
</MudText>
@if (UpdateService.IsSupported)
{
    <div class="mt-2">
        <AppSecondaryButton data-testid="check-updates-button"
                            Size="Size.Small"
                            Disabled="@(_checkingForUpdate || _applyingUpdate)"
                            OnClick="CheckForUpdatesAsync">
            Check for updates
        </AppSecondaryButton>
        @if (_availableUpdateVersion is not null)
        {
            <AppPrimaryButton data-testid="apply-update-button"
                              Class="ml-2" Size="Size.Small"
                              Disabled="@_applyingUpdate" OnClick="ApplyUpdateAsync">
                @if (_applyingUpdate)
                {
                    <MudProgressCircular Indeterminate Size="Size.Small" Class="mr-2" />
                    <span>Restarting…</span>
                }
                else
                {
                    <span>Update to @_availableUpdateVersion and restart</span>
                }
            </AppPrimaryButton>
            @if (_updateError)
            {
                <MudText Typo="Typo.body2" Color="Color.Error" Class="mt-1" data-testid="update-error">The update couldn't be started. Please try again.</MudText>
            }
        }
        else if (_updateCheckCompleted)
        {
            <MudText Typo="Typo.body2" Class="mt-1">You're up to date.</MudText>
        }
    </div>
}

@code {
    private string _version = string.Empty;
    private bool _checkingForUpdate;
    private bool _applyingUpdate;
    private bool _updateError;
    private bool _updateCheckCompleted;
    private string? _availableUpdateVersion;

    protected override void OnInitialized()
    {
        _version = AppInfoService.GetVersion();
    }

    private async Task CheckForUpdatesAsync()
    {
        _checkingForUpdate = true;
        _availableUpdateVersion = await UpdateService.CheckForUpdateAsync();
        _updateCheckCompleted = true;
        _checkingForUpdate = false;
    }

    private async Task ApplyUpdateAsync()
    {
        if (_applyingUpdate)
            return;

        _applyingUpdate = true;
        _updateError = false;
        await InvokeAsync(StateHasChanged);

        try
        {
            await UpdateService.DownloadAndApplyAsync();
        }
        catch
        {
            _applyingUpdate = false;
            _updateError = true;
            await InvokeAsync(StateHasChanged);
        }
    }
}
