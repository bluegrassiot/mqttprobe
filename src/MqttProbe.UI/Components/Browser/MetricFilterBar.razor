@using MqttProbe.Core.Models.Mqtt
@if (Label is { Length: > 0 } label)
{
    <div class="pb-metric-filter" role="group" aria-label="Metric filter">
        <div class="pb-metric-filter__row">
            <MudIcon Icon="@LucideIcons.Activity" Size="Size.Small" Class="pb-metric-filter__icon"/>
            @if (!HasSeveralMetrics)
            {
                <span class="pb-metric-filter__caption">Metric</span>
            }
            <span class="pb-metric-filter__label" title="@label">@label</span>
            @if (HasSeveralMetrics)
            {
                <MudIconButton Icon="@(_detailsOpen ? LucideIcons.ChevronUp : LucideIcons.ChevronDown)"
                               Size="Size.Small" Color="Color.Default"
                               Class="pb-metric-filter__details"
                               title="@DetailsLabel" aria-label="@DetailsLabel"
                               aria-expanded="@(_detailsOpen ? "true" : "false")"
                               aria-controls="@(_detailsOpen ? _listId : null)"
                               OnClick="ToggleDetails"/>
            }
            <MudIconButton Icon="@LucideIcons.X" Size="Size.Small" Color="Color.Default"
                           Class="pb-metric-filter__clear"
                           title="Clear metric filter" aria-label="Clear metric filter"
                           OnClick="OnClear"/>
        </div>
        @if (HasSeveralMetrics && _detailsOpen)
        {
            <ul class="pb-metric-filter__list" id="@_listId">
                @foreach (var metric in Metrics)
                {
                    <li class="pb-metric-filter__item">
                        <span class="pb-metric-filter__owner">@OwnerLabel(metric.Scope)</span>
                        <span class="pb-metric-filter__name">@metric.MetricName</span>
                    </li>
                }
            </ul>
        }
    </div>
}

@code {
    [Parameter] public string? Label { get; set; }

    [Parameter] public IReadOnlyList<MqttSparkplugMetricTarget> Metrics { get; set; } = [];

    [Parameter] public EventCallback OnClear { get; set; }

    private readonly string _listId = $"pb-metric-filter-list-{Guid.NewGuid():N}";
    private bool _detailsOpen;

    private bool HasSeveralMetrics => Metrics.Count > 1;

    private string DetailsLabel => _detailsOpen ? "Hide metric names" : "Show metric names";

    private void ToggleDetails() => _detailsOpen = !_detailsOpen;

    private static string OwnerLabel(SparkplugSelectionScope scope)
    {
        var owner = $"{scope.GroupPath}/{scope.NodeId}";
        return scope.DeviceId is { } device ? $"{owner}/{device}" : owner;
    }
}
