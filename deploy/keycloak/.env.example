# Keycloak admin credentials (used only on first start).
# Copy to .env and adjust if desired. The .env file is gitignored.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin

# Client secret for the mqttprobe OIDC client.
# Must match the secret in realm.json. The default matches the lab fixture.
MQTT_PROBE_CLIENT_SECRET=mqttprobe-test-secret