@namespace MqttProbe.Components.Settings
@using MqttProbe.Services.Configuration
@inject IUiSettings UiSettings

<MudSwitch T="bool" Value="@UiSettings.Ui.EnrichSparkplugAliasNames"
           ValueChanged="@OnEnrichAliasNamesChanged"
           Color="Color.Primary"
           Label="Enrich Sparkplug alias names" />
<MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
    When enabled, alias-only Sparkplug metrics are annotated with resolved names from the topology.
</MudText>

<MudSwitch T="bool" Value="@UiSettings.Ui.AutoRequestSparkplugRebirth"
           ValueChanged="@OnAutoRequestRebirthChanged"
           Color="Color.Primary"
           Class="mt-3"
           Label="Automatically request rebirth" />
<MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
    Asks nodes with no known birth to re-announce. Manual Rebirth still works when off.
</MudText>

<MudSwitch T="bool" Value="@UiSettings.Ui.AllowNodeReboot"
           ValueChanged="@OnAllowNodeRebootChanged"
           Color="Color.Primary"
           Class="mt-3"
           Label="Allow node reboot" />
<MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
    Lets you send Node Control/Reboot from the Sparkplug nodes view. Off by default. Rebirth commands stay available.
</MudText>

@code {
    private async Task OnEnrichAliasNamesChanged(bool value)
    {
        await UiSettings.SetEnrichSparkplugAliasNamesAsync(value);
    }

    private async Task OnAutoRequestRebirthChanged(bool value)
    {
        await UiSettings.SetAutoRequestSparkplugRebirthAsync(value);
    }

    private async Task OnAllowNodeRebootChanged(bool value)
    {
        await UiSettings.SetAllowNodeRebootAsync(value);
    }
}
