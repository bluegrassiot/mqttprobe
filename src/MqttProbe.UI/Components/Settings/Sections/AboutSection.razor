@namespace MqttProbe.UI.Components.Settings
@inject IAppInfoService AppInfoService
@inject IUpdateService UpdateService
@inject IDialogService DialogService

<MudText Typo="Typo.body2" Color="Color.Secondary">
    MQTTProbe — the MQTT diagnostic tool built for IIoT.
</MudText>
<MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
    Version @_version
</MudText>
<div class="about-links">
    <MudText Typo="Typo.subtitle1" HtmlTag="h6" Class="about-links__heading">Support</MudText>
    <div class="about-links__items">
        <a class="about-links__link"
           href="@ContactEmailUri"
           data-testid="contact-email-link">
            <MudIcon Icon="@LucideIcons.Send" Size="Size.Small" aria-hidden="true" />
            <span class="about-links__label">@ContactEmailAddress</span>
        </a>
        <a class="about-links__link"
           href="@SupportUri"
           target="_blank"
           rel="noopener noreferrer"
           aria-label="Support website (opens in a new tab)"
           data-testid="support-website-link">
            <MudIcon Icon="@LucideIcons.Info" Size="Size.Small" aria-hidden="true" />
            <span class="about-links__label">Support website</span>
            <MudIcon Icon="@LucideIcons.ExternalLink" Size="Size.Small" Class="about-links__external"
                     aria-hidden="true" />
        </a>
    </div>
    @if (IsIosHost)
    {
        <div class="about-links__privacy">
            <a class="about-links__link"
               href="@PrivacyPolicyUri"
               target="_blank"
               rel="noopener noreferrer"
               aria-label="Privacy policy (opens in a new tab)"
               data-testid="privacy-policy-link">
                <MudIcon Icon="@LucideIcons.ShieldCheck" Size="Size.Small" aria-hidden="true" />
                <span class="about-links__label">Privacy policy</span>
                <MudIcon Icon="@LucideIcons.ExternalLink" Size="Size.Small" Class="about-links__external"
                         aria-hidden="true" />
            </a>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="about-links__hint">
                What MQTTProbe stores and sends on your device.
            </MudText>
        </div>
    }
</div>

@if (UpdateService.IsSupported)
{
    <div class="mt-2">
        <AppSecondaryButton data-testid="check-updates-button"
                            Size="Size.Small"
                            Disabled="@(_checkingForUpdate || _applyingUpdate)"
                            OnClick="CheckForUpdatesAsync">
            Check for updates
        </AppSecondaryButton>
        @if (_availableUpdateVersion is not null)
        {
            <AppPrimaryButton data-testid="apply-update-button"
                              Class="ml-2" Size="Size.Small"
                              Disabled="@_applyingUpdate" OnClick="ApplyUpdateAsync">
                @if (_applyingUpdate)
                {
                    <MudProgressCircular Indeterminate Size="Size.Small" Class="mr-2" />
                    <span>Restarting…</span>
                }
                else
                {
                    <span>Update to @_availableUpdateVersion and restart</span>
                }
            </AppPrimaryButton>
            @if (_updateError)
            {
                <MudText Typo="Typo.body2" Color="Color.Error" Class="mt-1" data-testid="update-error">The update couldn't be started. Please try again.</MudText>
            }
        }
        else if (_updateCheckCompleted)
        {
            <MudText Typo="Typo.body2" Class="mt-1">You're up to date.</MudText>
        }
    </div>
}

<div class="about-legal">
    <button type="button"
            class="about-legal__button"
            data-testid="open-source-licences-button"
            @onclick="OpenLicencesAsync">
        <MudIcon Icon="@LucideIcons.FileText" Size="Size.Small" aria-hidden="true" />
        <span class="about-legal__label">Open-source licences</span>
    </button>
    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="about-legal__hint">
        The licence for MQTTProbe and the notices for the components it includes.
    </MudText>
</div>

@code {
    private string _version = string.Empty;
    private string _licenseText = string.Empty;
    private string _noticesText = string.Empty;
    private bool _checkingForUpdate;
    private bool _applyingUpdate;
    private bool _updateError;
    private bool _updateCheckCompleted;
    private string? _availableUpdateVersion;

    protected override void OnInitialized()
    {
        _version = AppInfoService.GetVersion();
        _licenseText = LegalDocuments.ReadLicense();
        _noticesText = LegalDocuments.ReadNotices();
    }

    private async Task OpenLicencesAsync()
    {
        var parameters = new DialogParameters<LicencesDialog>
        {
            { x => x.LicenseText, _licenseText },
            { x => x.NoticesText, _noticesText }
        };
        await DialogService.ShowAsync<LicencesDialog>(null, parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
    }

    private async Task CheckForUpdatesAsync()
    {
        _checkingForUpdate = true;
        _availableUpdateVersion = await UpdateService.CheckForUpdateAsync();
        _updateCheckCompleted = true;
        _checkingForUpdate = false;
    }

    private async Task ApplyUpdateAsync()
    {
        if (_applyingUpdate)
            return;

        _applyingUpdate = true;
        _updateError = false;
        await InvokeAsync(StateHasChanged);

        try
        {
            await UpdateService.DownloadAndApplyAsync();
        }
        catch
        {
            _applyingUpdate = false;
            _updateError = true;
            await InvokeAsync(StateHasChanged);
        }
    }
}
