@namespace MqttProbe.UI.Components.Sparkplug

@* MudTooltip delegates hover, focus and tap to this component so a tap is not toggled twice. *@
<MudTooltip Visible="_visible"
            Text="@Detail"
            Placement="Placement.Bottom"
            ShowOnClick="false"
            ShowOnFocus="false"
            ShowOnHover="false">
    <button type="button" class="spb-zone-token"
            @attributes="AdditionalAttributes"
            aria-label="@AccessibleLabel"
            @onclick="Toggle"
            @onpointerenter="HandlePointerEnter"
            @onpointerleave="HandlePointerLeave"
            @onfocus="Show"
            @onblur="Dismiss">@Abbreviation</button>
</MudTooltip>

@code {
    [Parameter, EditorRequired] public string Abbreviation { get; set; } = "";

    [Parameter, EditorRequired] public string Detail { get; set; } = "";

    [Parameter, EditorRequired] public string AccessibleLabel { get; set; } = "";

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private bool _visible;
    private bool _pinned;

    private void HandlePointerEnter(PointerEventArgs args)
    {
        if (args.PointerType != "touch")
            Show();
    }

    private void HandlePointerLeave(PointerEventArgs args)
    {
        if (args.PointerType != "touch")
            Dismiss();
    }

    private void Toggle()
    {
        _pinned = !_pinned;
        _visible = _pinned;
    }

    private void Show()
    {
        if (!_visible)
            _visible = true;
    }

    private void Dismiss()
    {
        _pinned = false;
        _visible = false;
    }
}
