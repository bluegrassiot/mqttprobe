@namespace MqttProbe.UI.Components.Sparkplug
@using MqttProbe.Core.Models.Sparkplug

@if (Node == null)
{
    <div class="d-flex flex-column align-center justify-center spb-empty-detail">
        <MudIcon Icon="@LucideIcons.Network" Size="Size.Large"/>
        <MudText Typo="Typo.body2" Class="mt-2">Select a node to view details</MudText>
    </div>
}
else
{
    var sequence = Node.Sequence;
    <MudPaper Elevation="0" Class="spb-detail-panel">
        <MudHidden Breakpoint="Breakpoint.MdAndUp">
            <AppTertiaryButton StartIcon="@LucideIcons.ArrowLeft"
                               OnClick="@OnBack" Class="mb-2">
                Back
            </AppTertiaryButton>
        </MudHidden>

        <div class="d-flex align-center flex-wrap gap-2 mb-1">
            <MudText Class="spb-detail-title">
                @Node.NodeId
            </MudText>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                     Class="spb-group-chip">
                @Node.GroupId
            </MudChip>
            <span class="spb-status-dot @NodeStatusClass(Node)"></span>
            <span class="spb-status-label @NodeStatusClass(Node)">
                @SparkplugNodeDisplay.NodeStatusLabel(Node)
            </span>
        </div>

        <div class="d-flex align-center flex-wrap gap-2 mb-3">
            <MudButton Variant="Variant.Outlined"
                       Size="Size.Small" Class="app-btn-min"
                       StartIcon="@LucideIcons.RefreshCw"
                       OnClick="@(() => OnRequestRebirth.InvokeAsync(Node))">
                Request rebirth
            </MudButton>
            <span title="@(AllowNodeReboot ? null : "Enable Allow node reboot in Settings, Sparkplug")">
                <MudButton Variant="Variant.Outlined"
                           Size="Size.Small" Class="app-btn-min"
                           StartIcon="@LucideIcons.Power"
                           Disabled="@(!AllowNodeReboot)"
                           OnClick="@(() => OnRequestReboot.InvokeAsync(Node))">
                    Reboot node
                </MudButton>
            </span>
        </div>

        <section class="spb-sequence-panel spb-sequence-panel--@sequence.State.ToString().ToLowerInvariant()" aria-label="Sequence diagnostics">
            <div class="spb-sequence-panel__heading">
                <MudText Typo="Typo.subtitle2">Message sequence</MudText>
                <span class="spb-sequence-state">@SequenceStateLabel(sequence.State)</span>
            </div>
            <div class="spb-sequence-values">
                <span>Next expected <strong class="metrics-mono">@(sequence.ExpectedSequence?.ToString() ?? "Unknown")</strong></span>
                <span>Last received <strong class="metrics-mono">@(sequence.ReceivedSequence?.ToString() ?? "Unknown")</strong></span>
                @if (sequence.MissingSequences.Count > 0)
                {
                    <span>Missing sequences <strong class="metrics-mono">@FormatMissingSequences(sequence.MissingSequences)</strong></span>
                }
            </div>
            <MudText Typo="Typo.caption" Class="spb-sequence-explanation">@SequenceExplanation(sequence.State)</MudText>
            @if (sequence.State is SpbSequenceState.Reordering or SpbSequenceState.GapDetected)
            {
                <MudText Typo="Typo.caption" Class="spb-sequence-caveat">Filtered, excluded or rate-limited traffic can also appear as gaps. A gap does not prove broker loss.</MudText>
            }
        </section>

        <div class="spb-timestamps d-flex flex-wrap gap-3 mb-3">
            @if (Node.LastBirthAt != null)
            {
                <span>
                    Birth:
                    <span class="metrics-mono">
                        @Node.LastBirthAt.Value.ToLocalTime().ToString("HH:mm:ss")
                    </span>
                </span>
            }
            @if (Node.LastDataAt != null)
            {
                <span>
                    Last data:
                    <span class="metrics-mono">
                        @Node.LastDataAt.Value.ToLocalTime().ToString("HH:mm:ss")
                    </span>
                    @if (Node.Status == SpbNodeStatus.Online)
                    {
                        <span class="spb-relative-time">(@DisplayHelpers.GetRelativeTime(Node.LastDataAt))</span>
                    }
                </span>
            }
            @if (Node.LastDeathAt != null && Node.Status == SpbNodeStatus.Offline)
            {
                <span>
                    Death:
                    <span class="metrics-mono">
                        @Node.LastDeathAt.Value.ToLocalTime().ToString("HH:mm:ss")
                    </span>
                </span>
            }
            @if (Node.LastRebirthRequestAt != null)
            {
                <span>
                    Rebirth requested:
                    <span class="metrics-mono">
                        @Node.LastRebirthRequestAt.Value.ToLocalTime().ToString("HH:mm:ss")
                    </span>
                </span>
            }
            <span>
                Birth/death session identifier (bdSeq):
                <span class="metrics-mono">@(Node.BirthDeathSequenceNumber?.ToString() ?? "Unknown")</span>
            </span>
        </div>

        <div class="spb-subsection-header">
            Metrics (@Node.Metrics.Count)
        </div>

        @if (Node.Metrics.Count == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                No metrics received yet
            </MudText>
        }
        else
        {
            <SparkplugMetricsTable Class="mb-3"
                                   Topic="@SparkplugChartTargets.NodeTopic(Node.GroupId, Node.NodeId)"
                                   Items="@Node.Metrics.OrderBy(m => m.Name, NaturalStringComparer.Instance)"
                                   OnAddToChart="OnAddMetricToChart" />
        }

        <div class="spb-subsection-header">
            Devices (@Node.Devices.Count)
        </div>

        @if (Node.Devices.Count == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">No devices observed</MudText>
        }
        else
        {
            @foreach (var device in Node.Devices.Values.OrderBy(d => d.DeviceId, NaturalStringComparer.Instance))
            {
                <div @key="device.DeviceId" class="spb-device-row @(ExpandedDevice == device ? "spb-device-row--expanded" : "")"
                     @onclick="() => OnToggleDevice.InvokeAsync(device)">
                    <span class="spb-status-dot @StatusClass(device.Status)"></span>
                    <span class="spb-device-id">@device.DeviceId</span>
                    <span class="spb-status-label spb-status-label--device @StatusClass(device.Status)">
                        @SparkplugNodeDisplay.StatusLabel(device.Status)
                    </span>
                    <span class="spb-device-secondary">
                        @SparkplugNodeDisplay.DeviceSecondaryText(device)
                    </span>
                    <span @onclick:stopPropagation="true" class="ms-auto">
                        <MudButton Variant="Variant.Outlined"
                                   Size="Size.Small" Class="app-btn-min"
                                   StartIcon="@LucideIcons.RefreshCw"
                                   OnClick="@(() => OnRequestDeviceRebirth.InvokeAsync(device))">
                            Rebirth
                        </MudButton>
                    </span>
                </div>

                @if (ExpandedDevice == device)
                {
                    <div class="spb-device-metrics">
                        @if (device.Metrics.Count == 0)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                No metrics received yet
                            </MudText>
                        }
                        else
                        {
                            <SparkplugMetricsTable
                                Topic="@SparkplugChartTargets.DeviceTopic(Node.GroupId, Node.NodeId, device.DeviceId)"
                                Items="@device.Metrics.OrderBy(m => m.Name, NaturalStringComparer.Instance)"
                                OnAddToChart="OnAddMetricToChart" />
                        }
                    </div>
                }
            }
        }
    </MudPaper>
}

@code {
    private static string NodeStatusClass(SpbNode node) => SparkplugNodeDisplay.IsStale(node)
        ? "spb-status--stale"
        : StatusClass(node.Status);

    private static string StatusClass(SpbNodeStatus status) => status switch
    {
        SpbNodeStatus.Online => "spb-status--online",
        SpbNodeStatus.Offline => "spb-status--offline",
        _ => "spb-status--unknown"
    };

    private static string SequenceStateLabel(SpbSequenceState state) => state switch
    {
        SpbSequenceState.InOrder => "In order",
        SpbSequenceState.Reordering => "Waiting for late messages",
        SpbSequenceState.GapDetected => "Unresolved gap",
        SpbSequenceState.Invalid => "Invalid sequence",
        _ => "Not enough data"
    };

    private static string SequenceExplanation(SpbSequenceState state) => state switch
    {
        SpbSequenceState.InOrder => "Observed message sequence is in order.",
        SpbSequenceState.Reordering => "A message is missing so far. Waiting for late messages before marking the gap unresolved.",
        SpbSequenceState.GapDetected => "Unresolved gaps in observed messages.",
        SpbSequenceState.Invalid => "The received sequence cannot be compared reliably.",
        _ => "Sequence diagnostics will appear after messages are observed."
    };

    private static string FormatMissingSequences(IReadOnlyList<byte> missingSequences)
    {
        if (missingSequences.Count == 0) return string.Empty;

        var ranges = new List<string>();
        var start = missingSequences[0];
        var end = start;

        for (var i = 1; i < missingSequences.Count; i++)
        {
            var current = missingSequences[i];
            if (end != byte.MaxValue && current == end + 1)
            {
                end = current;
                continue;
            }

            ranges.Add(FormatSequenceRun(start, end));
            start = current;
            end = current;
        }

        ranges.Add(FormatSequenceRun(start, end));
        return string.Join(", ", ranges);
    }

    private static string FormatSequenceRun(byte start, byte end) =>
        start == end ? start.ToString() : $"{start}-{end}";

    [Parameter]
    public SpbNode? Node { get; set; }

    [Parameter]
    public SpbDevice? ExpandedDevice { get; set; }

    [Parameter]
    public bool AllowNodeReboot { get; set; }

    [Parameter]
    public EventCallback OnBack { get; set; }

    [Parameter]
    public EventCallback<SpbDevice> OnToggleDevice { get; set; }

    [Parameter]
    public EventCallback<SpbNode> OnRequestRebirth { get; set; }

    [Parameter]
    public EventCallback<SpbNode> OnRequestReboot { get; set; }

    [Parameter]
    public EventCallback<SpbDevice> OnRequestDeviceRebirth { get; set; }

    [Parameter]
    public EventCallback<SparkplugChartSelection> OnAddMetricToChart { get; set; }
}
