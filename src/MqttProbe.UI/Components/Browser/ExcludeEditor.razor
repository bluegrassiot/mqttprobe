@using Microsoft.JSInterop
@using MudBlazor.Services
@implements IAsyncDisposable
@inject ISnackbar Snackbar
@inject IKeyInterceptorService KeyInterceptorService

<div id="@_rootId" class="exclude-editor"
     role="region" aria-label="Excluded topics list">
    <MudExpansionPanels Dense="true" Elevation="0">
        <MudExpansionPanel @ref="_panel" @bind-Expanded="_expanded" Dense="true">
            <TitleContent>
                <div class="d-flex align-center gap-2">
                    <MudText Typo="Typo.subtitle2">Excluded topics</MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                             Class="count-chip">
                        @(Items.Count + SparkplugItems.Count)
                    </MudChip>
                </div>
            </TitleContent>
            <ChildContent>
                <div class="exclude-editor-add-row">
                    <MudTextField T="string" Class="exclude-editor-topic"
                                  @bind-Value="_topic" Label="Topic" Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Clearable="true" Disabled="@Disabled" Immediate="true"
                                  Adornment="Adornment.Start" AdornmentIcon="@LucideIcons.ChevronRight"
                                  OnKeyDown="HandleKeyDown" />
                    <AppPrimaryButton Class="exclude-editor-add"
                                      StartIcon="@LucideIcons.Plus" title="Add exclude topic"
                                      Disabled="@(Disabled || _busy)" OnClick="@AddAsync">
                        Add
                    </AppPrimaryButton>
                </div>

                <div class="exclude-editor-presets">
                    <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Disabled="@Disabled"
                             OnClick="@(() => ApplyPreset("$SYS/#"))">$SYS/#</MudChip>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ml-2">
                        Wildcards: <code>+</code> matches one level, <code>#</code> matches remaining levels.
                    </MudText>
                </div>

                @if (Items is { Count: > 0 })
                {
                    <div class="exclude-editor-table-wrap">
                        <MudTable T="string"
                                  Items="@Items"
                                  MultiSelection="true"
                                  @bind-SelectedItems="_selected"
                                  Hover="true"
                                  Dense="true"
                                  Striped="true"
                                  Breakpoint="Breakpoint.None">
                            <ToolBarContent>
                                <MudSpacer />
                                <div class="exclude-editor-actions">
                                    <AppDestructiveButton StartIcon="@LucideIcons.Trash2" title="Remove"
                                                          Disabled="@(Disabled || _selected is null || _selected.Count == 0)"
                                                          OnClick="@RemoveSelectedAsync">
                                        Remove
                                    </AppDestructiveButton>
                                </div>
                            </ToolBarContent>
                            <HeaderContent>
                                <MudTh>Topic</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd Class="metrics-mono metrics-compact">@context</MudTd>
                            </RowTemplate>
                        </MudTable>
                    </div>
                }

                @if (SparkplugItems is { Count: > 0 })
                {
                    <div class="exclude-editor-table-wrap">
                        <MudTable T="SparkplugTopicExclude" Items="@SparkplugItems"
                                  Hover="true" Dense="true" Striped="true" Breakpoint="Breakpoint.None">
                            <HeaderContent>
                                <MudTh>Sparkplug exclusion</MudTh>
                                <MudTh></MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd Class="metrics-mono metrics-compact">@SparkplugLabel(context)</MudTd>
                                <MudTd Class="exclude-editor-row-action">
                                    <AppDestructiveButton Size="Size.Small" StartIcon="@LucideIcons.Trash2"
                                                          title="Remove Sparkplug exclusion"
                                                          Disabled="@Disabled"
                                                          OnClick="@(() => OnRemoveSparkplug(context))">
                                        Remove
                                    </AppDestructiveButton>
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Logical Sparkplug scopes, including members added later.
                        </MudText>
                    </div>
                }
            </ChildContent>
        </MudExpansionPanel>
    </MudExpansionPanels>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<string> Items { get; set; } = [];
    [Parameter] public IReadOnlyList<SparkplugTopicExclude> SparkplugItems { get; set; } = [];
    [Parameter] public bool Disabled { get; set; }
    // Returns true when the parent accepted the topic. A rejected add keeps the draft
    // so the user can correct it instead of retyping.
    [Parameter] public Func<string, Task<bool>> OnAdd { get; set; } = _ => Task.FromResult(true);
    [Parameter] public EventCallback<IReadOnlyList<string>> OnRemove { get; set; }
    [Parameter] public Func<SparkplugTopicExclude, Task> OnRemoveSparkplug { get; set; } = _ => Task.CompletedTask;

    private string _topic = string.Empty;
    private HashSet<string> _selected = [];
    private bool _busy;
    private bool _expanded;
    private bool _initialStateSet;
    private readonly string _rootId = $"exclude-editor-{Guid.NewGuid():N}";
    private MudExpansionPanel? _panel;

    internal string TopicDraft { get => _topic; set => _topic = value; }
    internal Task AddForTests() => AddAsync();
    internal Task RemoveSelectedForTests() => RemoveSelectedAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await KeyInterceptorService.SubscribeAsync(
            _rootId,
            new KeyInterceptorOptions(
                "mud-expand-panel-header",
                new KeyOptions("ArrowRight", subscribeDown: true, ignoreDownRepeats: true),
                new KeyOptions("ArrowLeft", subscribeDown: true, ignoreDownRepeats: true)),
            HandleDisclosureKeyDown);
    }

    private async Task HandleDisclosureKeyDown(KeyboardEventArgs e)
    {
        if (_panel is null || e.Repeat || e.IsComposing ||
            e.CtrlKey || e.AltKey || e.MetaKey || e.ShiftKey)
            return;

        if (e.Key == "ArrowRight")
            await _panel.ExpandAsync();
        else if (e.Key == "ArrowLeft")
            await _panel.CollapseAsync();
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await KeyInterceptorService.UnsubscribeAsync(_rootId);
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone; the browser drops the listener with the page.
        }
    }

    protected override void OnParametersSet()
    {
        // Initialize expansion once based on whether items exist; preserve
        // user toggles on subsequent parameter updates.
        if (!_initialStateSet)
        {
            _expanded = Items is { Count: > 0 } || SparkplugItems is { Count: > 0 };
            _initialStateSet = true;
        }
    }

    private static string SparkplugLabel(SparkplugTopicExclude exclude) =>
        TopicBranchTargetDisplay.Label(new TopicBranchTarget(
            TopicBranchKind.Sparkplug, Scope: exclude.Scope, MessageType: exclude.MessageType));

    private void ApplyPreset(string topicFilter)
    {
        if (Disabled) return;
        _topic = topicFilter;
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await AddAsync();
    }

    private async Task AddAsync()
    {
        if (Disabled || _busy || string.IsNullOrWhiteSpace(_topic))
            return;
        _busy = true;
        try
        {
            var topic = _topic.Trim();
            if (await OnAdd(topic))
                _topic = string.Empty;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RemoveSelectedAsync()
    {
        if (Disabled) return;
        if (_selected is null || _selected.Count == 0)
        {
            Snackbar.Add("Select at least one topic to remove.", Severity.Info);
            return;
        }
        await OnRemove.InvokeAsync(_selected.ToList());
        _selected = [];
    }
}
