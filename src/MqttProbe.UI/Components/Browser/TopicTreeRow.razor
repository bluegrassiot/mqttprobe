@inject IMessageStoreManager MessageStoreManager

<div class="topic-tree-row d-flex align-center @(Row.Depth == 0 ? "font-weight-bold" : "") @(Row.IsVirtualTopic ? "topic-tree-row--group" : "") @(IsSelected ? "topic-tree-row--selected" : "")"
     title="@(Row.IsVirtualTopic ? "Grouping row · not an MQTT topic" : null)"
     @onclick="OnRowClick">
    <svg class="topic-tree-indent" width="@IndentWidth" height="1" aria-hidden="true" focusable="false"></svg>
    @if (Row.HasChildren)
    {
        <span @onclick:stopPropagation="true">
            <MudIconButton Icon="@(Row.IsExpanded ? LucideIcons.ChevronDown : LucideIcons.ChevronRight)"
                           Size="Size.Small"
                           OnClick="OnToggleExpand"/>
        </span>
    }
    else
    {
        <div class="topic-tree-chevron-spacer" aria-hidden="true"></div>
    }
    <MudIcon Icon="@NodeIcon" Size="Size.Small" Color="@NodeColor" Class="mx-1"/>
    <span class="flex-grow-1" title="@Row.DisplayName">
        @if (Row.IsVirtualTopic)
        {
            <span class="topic-group-label">@Row.DisplayName</span>
        }
        else
        {
            <span>@Row.DisplayName</span>
        }
    </span>
    <span class="topic-stat-text" title="@($"{Row.TopicCount:N0} topics, {Row.MessageCount:N0} messages")">
        T @Row.TopicCount.ToString("N0") · M @Row.MessageCount.ToString("N0")
    </span>
</div>

@code {
    [Parameter] public TopicTreeRowModel Row { get; set; } = null!;
    [Parameter] public bool IsSelected { get; set; }
    [Parameter] public EventCallback<string> OnExpandToggled { get; set; }
    [Parameter] public EventCallback<string> OnSelected { get; set; }

    private const int IndentStepWidth = 16;

    // The indent is one SVG whose width attribute is the whole depth, rather than one spacer per
    // level, so a row costs the same DOM at depth 1000 as at depth 0. The attribute is a real SVG
    // geometry width, which avoids both an inline style and a depth-keyed set of classes.
    private int IndentWidth => Row.Depth * IndentStepWidth;

    private string NodeIcon => Row.Kind switch
    {
        TopicTreeRowKind.SparkplugNamespace => LucideIcons.Zap,
        TopicTreeRowKind.SparkplugGroup => LucideIcons.Layers,
        TopicTreeRowKind.SparkplugNode => LucideIcons.Cpu,
        TopicTreeRowKind.NodeMessages or TopicTreeRowKind.Devices => LucideIcons.Folder,
        TopicTreeRowKind.SparkplugDevice => LucideIcons.Network,
        TopicTreeRowKind.MessageType => LucideIcons.Hash,
        _ => (Row.IsValueBearer, Row.HasChildren) switch
        {
            (true, _) => LucideIcons.Database,
            (false, true) => LucideIcons.Folder,
            (false, false) => LucideIcons.Circle
        }
    };

    private Color NodeColor
    {
        get
        {
            if (Row.IsVirtualTopic)
                return Color.Secondary;

            if (Row.IsValueBearer)
                return Color.Success;

            return Row.Depth switch
            {
                0 => Color.Primary,
                1 => Color.Info,
                _ => Color.Secondary
            };
        }
    }

    private async Task OnRowClick()
    {
        // Grouping rows only navigate the view; they must never supply a fabricated topic
        // to the message store, which would select a topic that does not exist.
        if (Row.IsVirtualTopic)
        {
            await OnExpandToggled.InvokeAsync(Row.FullPath);
            return;
        }

        MessageStoreManager.SelectTopic(Row.FullPath);
        var selection = MessageStoreManager.GetSelectedTopicState();
        if (!string.Equals(selection.FullTopic, Row.FullPath, StringComparison.Ordinal))
            return;

        await OnSelected.InvokeAsync(Row.FullPath);
    }

    private async Task OnToggleExpand() =>
        await OnExpandToggled.InvokeAsync(Row.FullPath);
}
