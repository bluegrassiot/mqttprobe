@namespace MqttProbe.UI.Components.Settings
@using MqttProbe.Core.Models.Configuration
@using MqttProbe.Core.Services.Configuration
@inject IUiSettings UiSettings
@inject IThemes Themes

<div class="settings-field">
    <MudSelect T="string" Label="Theme"
               Value="@UiSettings.Ui.Theme"
               ValueChanged="@OnThemeSelectionChanged"
               Variant="Variant.Outlined"
               Margin="Margin.Dense"
               Class="settings-field-medium">
        <MudSelectItem Value="@("light")">Light</MudSelectItem>
        <MudSelectItem Value="@("dark")">Dark</MudSelectItem>
    </MudSelect>
</div>

<div class="settings-field">
    <MudSelect T="string" Label="Font profile"
               Value="@UiSettings.Ui.FontProfile"
               ValueChanged="@OnFontProfileChanged"
               Variant="Variant.Outlined"
               Margin="Margin.Dense"
               Class="settings-field-medium">
        <MudSelectItem Value="@(FontProfiles.Standard)">Standard</MudSelectItem>
        <MudSelectItem Value="@(FontProfiles.Accessible)">Accessible</MudSelectItem>
    </MudSelect>
    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="settings-caption">
        Accessible uses OpenDyslexic for easier reading
    </MudText>
</div>

<div class="settings-field">
    <MudSwitch T="bool" Value="@UiSettings.Ui.TopicTreeMultiSelect"
               ValueChanged="@OnTopicTreeMultiSelectChanged"
               Color="Color.Primary"
               Label="Enable multi-select in the topic tree" />
    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="settings-caption">
        Adds checkboxes and bulk actions to the topic tree. When off, clicking a topic selects that topic alone.
    </MudText>
</div>

@code {
    private void OnThemeSelectionChanged(string? value)
    {
        Themes.SetTheme(value == "dark");
    }

    private void OnFontProfileChanged(string? value)
    {
        Themes.SetFontProfile(value ?? FontProfiles.Standard);
    }

    private async Task OnTopicTreeMultiSelectChanged(bool value)
    {
        await UiSettings.SetTopicTreeMultiSelectAsync(value);
    }
}
