@using System.Collections.Immutable

<MudDialog DefaultFocus="DefaultFocus.None">
    <TitleContent>
        <MudText Typo="Typo.h6">Clear messages for selected topics</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="topic-clear-dialog__lead">
            Stored messages at these exact topic paths are removed. Messages on other topics stay,
            and new messages keep arriving.
        </MudText>
        <TopicTargetList Topics="Topics"/>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="topic-clear-dialog__note">
            The selected topics stay selected after the clear, even when they hold no messages.
        </MudText>
    </DialogContent>
    <DialogActions>
        <AppTertiaryButton @ref="_cancelButton" Class="topic-clear-dialog__cancel" OnClick="Cancel">Cancel</AppTertiaryButton>
        <AppDestructiveButton Class="topic-clear-dialog__confirm" OnClick="Confirm"
                              StartIcon="@LucideIcons.Trash2">
            Clear messages
        </AppDestructiveButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public ImmutableArray<string> Topics { get; set; }

    private AppTertiaryButton? _cancelButton;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _cancelButton is not null)
            await _cancelButton.FocusAsync();
    }

    private void Cancel() => MudDialog.Cancel();

    private void Confirm() => MudDialog.Close(DialogResult.Ok(Topics));
}
