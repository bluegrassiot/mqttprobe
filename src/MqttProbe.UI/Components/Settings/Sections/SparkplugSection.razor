@namespace MqttProbe.UI.Components.Settings
@using MqttProbe.Core.Services.Configuration
@inject ISparkplugSettings SparkplugSettings
@inject IUiSettings UiSettings

<div class="settings-field">
    <MudSwitch T="bool" Value="@UiSettings.Ui.GroupSparkplugTopicsByNodeAndDevice"
               ValueChanged="@OnGroupSparkplugTopicsChanged"
               Color="Color.Primary"
               Label="Group Sparkplug topics by node and device" />
    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="settings-caption">
        Groups the topic tree by node and device. Display only: topics, subscriptions and payloads are unchanged.
    </MudText>
</div>

<div class="settings-field">
    <MudSwitch T="bool" Value="@SparkplugSettings.Sparkplug.EnrichAliasNames"
               ValueChanged="@OnEnrichAliasNamesChanged"
               Color="Color.Primary"
               Label="Enrich Sparkplug alias names" />
    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="settings-caption">
        Names alias-only metrics using Sparkplug topology.
    </MudText>
</div>

<div class="settings-field settings-field-group">
    <MudSwitch T="bool" Value="@SparkplugSettings.Sparkplug.AutoRequestRebirth"
               ValueChanged="@OnAutoRequestRebirthChanged"
               Color="Color.Primary"
               Label="Automatically request rebirth" />
    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="settings-caption">
        Requests rebirth when a node has no known birth or a sequence gap remains unresolved after the wait below. Requests wait for a complete observation and follow the cooldown. Manual rebirth still works when off.
    </MudText>

    <MudNumericField T="int" Label="Sequence reorder wait (ms)"
                     Value="@SparkplugSettings.Sparkplug.ReorderTimeoutMilliseconds"
                     ValueChanged="@OnReorderTimeoutChanged"
                     Min="0" Max="60000" Step="500"
                     Variant="Variant.Outlined"
                     Margin="Margin.Dense"
                     Class="settings-field-narrow" />
    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="settings-caption">
        Wait 0 to 60,000 ms for late messages before treating a sequence gap as unresolved. 0 ms acts immediately.
    </MudText>

    <MudNumericField T="int" Label="Rebirth cooldown (s)"
                     Value="@SparkplugSettings.Sparkplug.RebirthCooldownSeconds"
                     ValueChanged="@OnRebirthCooldownChanged"
                     Min="5" Max="600" Step="5"
                     Variant="Variant.Outlined"
                     Margin="Margin.Dense"
                     Class="settings-field-narrow" />
    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="settings-caption">
        Minimum seconds between automatic rebirths for the same node. Manual not affected.
    </MudText>
</div>

<div class="settings-field">
    <MudSwitch T="bool" Value="@SparkplugSettings.Sparkplug.AllowNodeReboot"
               ValueChanged="@OnAllowNodeRebootChanged"
               Color="Color.Primary"
               Label="Allow node reboot" />
    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="settings-caption">
        Enables reboot from the nodes view. Rebirth stays available.
    </MudText>
</div>

@code {
    private async Task OnGroupSparkplugTopicsChanged(bool value)
    {
        await UiSettings.SetGroupSparkplugTopicsByNodeAndDeviceAsync(value);
    }

    private async Task OnEnrichAliasNamesChanged(bool value)
    {
        await SparkplugSettings.SetEnrichAliasNamesAsync(value);
    }

    private async Task OnAutoRequestRebirthChanged(bool value)
    {
        await SparkplugSettings.SetAutoRequestRebirthAsync(value);
    }

    private async Task OnRebirthCooldownChanged(int value)
    {
        await SparkplugSettings.SetRebirthCooldownSecondsAsync(value);
    }

    private async Task OnReorderTimeoutChanged(int value)
    {
        await SparkplugSettings.SetReorderTimeoutMillisecondsAsync(Math.Clamp(value, 0, 60_000));
    }

    private async Task OnAllowNodeRebootChanged(bool value)
    {
        await SparkplugSettings.SetAllowNodeRebootAsync(value);
    }
}
