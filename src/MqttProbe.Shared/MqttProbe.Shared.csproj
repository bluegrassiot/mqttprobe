<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>MqttProbe</RootNamespace>

        <!-- This assembly ships inside the single-file Web build, where IL3000-class
             mistakes only surface at release time. Enabled here so an ordinary build
             fails instead of the tag. -->
        <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>

        <!-- Both of these come from Razor emitting component code outside a #nullable
             context, and neither is suppressible via .editorconfig: severity there is
             resolved against the generated document, and source-generator output is
             not covered by it at all.

             CS8669: a nullable type argument in markup (MudSelect T="string?", which
             is what makes the "All" option null) is correct, but the scaffolding Razor
             emits around it is not in a nullable context. <Nullable>enable</Nullable>
             above means this cannot fire on hand-written code here.

             S8970: claims the ! operators in markup are pointless "because nullable
             warnings are disabled". They are not pointless — the generated context is
             simply not annotated. They document real intent and would become
             load-bearing if that is ever fixed.

             S2292 (SubscriptionEditor.razor TopicDraft/QosDraft) and S5693
             (PluginSettingsPanel.razor OnFileSelected) are the same story: both are
             reported against Razor @code blocks, so neither #pragma nor a
             file-scoped .editorconfig entry suppresses them (confirmed: a global
             [*.razor] severity=none for both still left them firing). See the
             comments at each flagged member for why each is a deliberate no-op. -->
        <NoWarn>$(NoWarn);CS8669;S8970;S2292;S5693</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Blazor.Lucide" />
        <PackageReference Include="FluentValidation" />
        <PackageReference Include="Google.Protobuf" />
        <PackageReference Include="Meziantou.Analyzer">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <!-- Aliased: Google.Protobuf and protobuf-net.Reflection collide -->
        <PackageReference Include="protobuf-net.Reflection" Aliases="ProtoReflection" />
        <PackageReference Include="MessagePack" />
        <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" />
        <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
        <PackageReference Include="MQTTnet" />
        <PackageReference Include="MudBlazor" />
        <PackageReference Include="SonarAnalyzer.CSharp">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="System.Reflection.MetadataLoadContext" />
        <PackageReference Include="System.Threading.RateLimiting" />
        <PackageReference Include="Blazor-ApexCharts" />
    </ItemGroup>

    <ItemGroup>
        <!-- SparkplugNet consumed from the git submodule (fork on MQTTnet 5.2.x)
             instead of the NuGet package (which pins MQTTnet 4). -->
        <ProjectReference Include="..\..\external\SparkplugNet\src\SparkplugNet\SparkplugNet.csproj" />
    </ItemGroup>

</Project>
