@inject ITopicSelectionStore TopicSelectionStore
@inject IUiSettings UiSettings
@inject ILogger<TopicBrowser> Logger
@using System.Collections.Immutable
@using Microsoft.Extensions.Logging
@using MqttProbe.Core.Services.Configuration
@implements IAsyncDisposable

<MudPaper Elevation="1" Class="pa-2 app-chrome-panel topic-browser-panel">
    <div class="topic-header-row">
        <span class="topic-select-all-wrap" title="@GlobalSelectTitle">
            <MudCheckBox T="bool?" Value="@GlobalCheckboxValue" ValueChanged="OnGlobalCheckboxChanged"
                         TriState="true" Dense="true" Color="Color.Primary"
                         Class="topic-select-all"
                         Disabled="@(_rootTopicCount == 0)">
                <span class="topic-select-all__name">@GlobalSelectLabel</span>
            </MudCheckBox>
        </span>
        <MudIcon Icon="@LucideIcons.Layers" Size="Size.Small" Color="Color.Primary"/>
        <MudText Typo="Typo.subtitle2" Class="topic-title">Topics</MudText>
        @if (_rootTopicCount > 0)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                     Class="topic-count-chip">
                @_rootTopicCount
            </MudChip>
        }
        <MudIconButton Icon="@LucideIcons.Info" Size="Size.Small" Class="topic-icon-key-toggle"
                       title="Icon key" aria-label="Icon key"
                       aria-expanded="@(_iconKeyOpen ? "true" : "false")" aria-controls="@IconKeyControls"
                       OnClick="ToggleIconKey"/>
    </div>
    <div class="topic-filter-wrap">
        <MudTextField @ref="_filterField" @bind-Value="_searchFilter" @bind-Value:after="OnSearchChanged"
                      Placeholder="Filter&hellip;"
                      Adornment="Adornment.Start" AdornmentIcon="@LucideIcons.Search"
                      Immediate="true" Clearable="true" Variant="Variant.Outlined"
                      Margin="Margin.Dense" Class="topic-filter-field"/>
    </div>
    <div class="topic-tree-wrap @TreeThemeClass">
        <MudToolBar Class="pa-0 mb-1 topic-toolbar">
            <MudIconButton Icon="@LucideIcons.Maximize2" Size="Size.Small"
                           title="Expand all" aria-label="Expand all" OnClick="ExpandAll"/>
            <MudIconButton Icon="@LucideIcons.Minimize2" Size="Size.Small"
                           title="Collapse all" aria-label="Collapse all" OnClick="CollapseAll"/>
            @if (_groupSparkplugTopics)
            {
                <span class="topic-grouping-flag"
                      title="Grouped by node and device. Change this in Settings, under Sparkplug.">
                    <MudIcon Icon="@LucideIcons.Zap" Size="Size.Small"/>
                    Grouped by node and device
                </span>
            }
            <span class="topic-stat-legend">T = topics · M = messages</span>
        </MudToolBar>
        @if (_iconKeyOpen)
        {
            <div class="topic-icon-key" id="@_iconKeyId" role="group" aria-label="Icon key">
                <div class="topic-icon-key-header">
                    <span class="topic-icon-key-title">Icon key</span>
                    <MudIconButton Icon="@LucideIcons.X" Size="Size.Small"
                                   title="Close icon key" aria-label="Close icon key" OnClick="CloseIconKey"/>
                </div>
                <div class="topic-icon-key-columns">
                    <div class="topic-icon-key-column">
                        <span class="topic-icon-key-heading">Topic rows</span>
                        <ul class="topic-icon-key-list">
                            <li data-icon-key="branch">
                                <span class="topic-icon-key-glyphs">
                                    <MudIcon Icon="@TopicTreeIconLanguage.BranchGlyph(isExpanded: false)" Size="Size.Small"
                                             Class="topic-node-icon topic-role--branch"/>
                                    <MudIcon Icon="@TopicTreeIconLanguage.BranchGlyph(isExpanded: true)" Size="Size.Small"
                                             Class="topic-node-icon topic-role--branch"/>
                                </span>
                                <span class="topic-icon-key-text">Topic with subtopics (folder)</span>
                            </li>
                            <li data-icon-key="leaf">
                                <span class="topic-icon-key-glyphs">
                                    <MudIcon Icon="@TopicTreeIconLanguage.LeafGlyph" Size="Size.Small"
                                             Class="topic-node-icon topic-role--leaf"/>
                                </span>
                                <span class="topic-icon-key-text">Topic with no subtopics (green circle, not health or message presence)</span>
                            </li>
                            <li data-icon-key="counts">
                                <span class="topic-icon-key-glyphs">
                                    <span class="topic-icon-key-sample">T 3 · M 42</span>
                                </span>
                                <span class="topic-icon-key-text">Topics below; messages there and below</span>
                            </li>
                        </ul>
                    </div>
                    <div class="topic-icon-key-column">
                        <span class="topic-icon-key-heading">Sparkplug grouping</span>
                        <ul class="topic-icon-key-list">
                            @foreach (var role in SparkplugRoles)
                            {
                                <li data-icon-key="@role.Hook">
                                    <span class="topic-icon-key-glyphs">
                                        <MudIcon Icon="@TopicTreeIconLanguage.RoleGlyph(role.Kind)" Size="Size.Small"
                                                 Class="@($"topic-node-icon {TopicTreeIconLanguage.RoleClass(role.Kind)}")"/>
                                    </span>
                                    <span class="topic-icon-key-text">@role.Explanation</span>
                                </li>
                            }
                            <li data-icon-key="message-type">
                                <span class="topic-icon-key-glyphs">
                                    <MudIcon Icon="@TopicTreeIconLanguage.MessageTypeGlyph" Size="Size.Small"
                                             Class="topic-node-icon topic-role--node"/>
                                    <MudIcon Icon="@TopicTreeIconLanguage.MessageTypeGlyph" Size="Size.Small"
                                             Class="topic-node-icon topic-role--device"/>
                                </span>
                                <span class="topic-icon-key-text">Message type, such as NDATA or NCMD: violet under a node, amber under a device</span>
                            </li>
                            <li data-icon-key="grouping-row">
                                <span class="topic-icon-key-glyphs">
                                    <span class="topic-icon-key-sample topic-icon-key-sample--group">grouping</span>
                                </span>
                                <span class="topic-icon-key-text">Grouping row: not a real MQTT topic</span>
                            </li>
                        </ul>
                    </div>
                </div>
                <p class="topic-icon-key-note">Shape and colour name the category. Labels and tooltips carry the same meaning without relying on colour.</p>
            </div>
        }
        @if (_visibleRows.Count > 0)
        {
            <div class="topic-tree" role="tree" aria-label="Topics" aria-multiselectable="true"
                 id="@_treeId" @ref="_treeElement">
                <Virtualize Items="@_visibleRows" Context="row" ItemSize="@RowHeight">
                    <TopicTreeRow @key="row.RowKey" Row="row"
                                  SelectionState="@SelectionStateOf(row.Branch)"
                                  InheritedSelectionLabel="@InheritedSelectionLabel(row)"
                                  IsTabStop="@IsActiveRow(row)"
                                  OnExpandToggled="ToggleExpand"
                                  OnSelectionToggled="ToggleRowSelection"
                                  OnKeyPressed="args => OnRowKeyPressed(row, args)"
                                  OnFocused="OnRowFocused"/>
                </Virtualize>
            </div>
        }
        else if (_rootTopicCount > 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-3">
                No topics match "@_searchFilter"
            </MudText>
        }
        else
        {
            <div class="d-flex flex-column align-center pa-6 topic-empty">
                <MudIcon Icon="@LucideIcons.Inbox" Size="Size.Large" Color="Color.Secondary"/>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">No messages received yet</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">Press play to start capturing</MudText>
            </div>
        }
    </div>
</MudPaper>

@code {
    private string? _searchFilter;
    [CascadingParameter(Name = "IsDarkMode")] private bool? DarkMode { get; set; }
    private Timer? _updateTimer;
    private bool _disposed;
    private bool _groupSparkplugTopics;
    private bool _iconKeyOpen;

    // A responsive layout can mount two browsers at once, so the panel id must belong to this
    // instance. It is generated once, which keeps aria-controls stable across renders.
    private readonly string _iconKeyId = $"topic-icon-key-{Guid.NewGuid():N}";
    private TopicSelectionSession? _selectionSession;
    private TopicBulkSelection _bulkSelection = null!;
    private int _rootTopicCount;
    private List<TopicTreeRowModel> _visibleRows = [];
    private readonly HashSet<string> _expandedPaths = [];
    private ImmutableArray<TopicBranchTarget> _rootBranches = [];
    private TopicTreeSelectionState _globalState = TopicTreeSelectionState.Unchecked;

    // The key explains the glyphs of both tree modes from one place, so it names every Sparkplug
    // role the grouping view can show. A message type keeps its own hue from its owner rather than
    // a colour of its own, so the node and device lines are joined by one explicit message-type
    // line that shows both owner tones.
    private static readonly (TopicTreeRowKind Kind, string Hook, string Explanation)[] SparkplugRoles =
    [
        (TopicTreeRowKind.SparkplugNamespace, "namespace", "Sparkplug namespace (spBv1.0)"),
        (TopicTreeRowKind.SparkplugGroup, "group", "Sparkplug group id"),
        (TopicTreeRowKind.SparkplugNode, "node", "Node or gateway that published"),
        (TopicTreeRowKind.SparkplugDevice, "device", "Device under that node")
    ];

    [Parameter] public EventCallback<SelectedTopicState> OnSelectedChanged { get; set; }

    [CascadingParameter] private TopicBulkSelection? BulkSelectionHost { get; set; }

    private string? IconKeyControls => _iconKeyOpen ? _iconKeyId : null;

    // The app opens in dark mode, so a bare instance or a unit test that cannot cascade still
    // gets the dark tones rather than light tones on a dark surface.
    private string TreeThemeClass => (DarkMode ?? true) ? "topic-tree--dark" : "topic-tree--light";

    private void ToggleIconKey() => _iconKeyOpen = !_iconKeyOpen;

    private void CloseIconKey() => _iconKeyOpen = false;

    protected override void OnInitialized()
    {
        _groupSparkplugTopics = UiSettings.Ui.GroupSparkplugTopicsByNodeAndDevice;
        _selectionSession = new TopicSelectionSession(TopicSelectionStore);
        _bulkSelection = BulkSelectionHost ?? new TopicBulkSelection(TopicSelectionStore);
        _bulkSelection.Changed += OnBulkSelectionChanged;
        BuildVisibleRows();
        UiSettings.UiPreferencesChanged += OnUiPreferencesChanged;
        _updateTimer = new Timer(_ =>
        {
            // Timer callbacks cannot await; the refresh marshals its work to the renderer.
#pragma warning disable CS4014
            RefreshAsync();
#pragma warning restore CS4014
        }, null, 0, 1_000);
    }

    // Only the grouping flag alters the tree, and it applies at once rather than on the next tick.
    private void OnUiPreferencesChanged() => _ = ApplyGroupingPreferenceAsync();

    private async Task ApplyGroupingPreferenceAsync()
    {
        try
        {
            await InvokeAsync(() =>
            {
                if (_disposed) return;

                var grouped = UiSettings.Ui.GroupSparkplugTopicsByNodeAndDevice;
                if (grouped == _groupSparkplugTopics) return;

                _groupSparkplugTopics = grouped;
                if (!grouped)
                    _expandedPaths.RemoveWhere(TopicTreeProjection.IsVirtualExpansionId);

                BuildVisibleRows();
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException) when (_disposed) { /* component torn down before the preference was applied */ }
        catch (Exception ex) { Logger.LogWarning(ex, "TopicBrowser preference refresh failed"); }
    }

    private void BuildVisibleRows(bool force = true)
    {
        ApplyFrame(RefreshFrame(force));
    }

    private TopicSelectionFrame? RefreshFrame(bool force)
    {
        ReconcileBulkSelection();
        return _selectionSession!.Refresh(_searchFilter, _expandedPaths, _groupSparkplugTopics, force,
            selectionMode: true);
    }

    private void ReconcileBulkSelection()
    {
        if (!_bulkSelection.HasSelection)
            return;

        var roots = TopicSelectionStore.GetTopicTreeSnapshot().Roots;
        _bulkSelection.Reconcile(target => ContainsBranch(roots, target));
    }

    private static bool ContainsBranch(
        ImmutableArray<TopicNodeSnapshot> nodes, TopicBranchTarget target)
    {
        foreach (var node in nodes)
        {
            if (node.FullTopic is { } path
                && (TopicBranchMatcher.Matches(target, path)
                    || (target.Kind == TopicBranchKind.Raw
                        && string.Equals(path, target.Path, StringComparison.Ordinal))))
                return true;

            if (ContainsBranch(node.Children, target))
                return true;
        }

        return false;
    }

    internal async Task RefreshAsync()
    {
        try
        {
            await InvokeAsync(() =>
            {
                if (_disposed) return;

                var frame = RefreshFrame(force: false);
                if (frame is null)
                    return;
                ApplyFrame(frame);
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException) when (_disposed) { /* component torn down mid-refresh; nothing left to render */ }
        catch (Exception ex) { Logger.LogWarning(ex, "TopicBrowser refresh render failed"); }
    }

    // A row checked only through a branch above it is not its own target, so its checkbox is
    // read-only and names the branch that covers it.
    private string? InheritedSelectionLabel(TopicTreeRowModel row) =>
        !_bulkSelection.Contains(row.Branch)
            ? _bulkSelection.CoveringLabel(row.Branch)
            : null;

    private TopicTreeSelectionState SelectionStateOf(TopicBranchTarget branch)
    {
        var branches = _bulkSelection.Branches;
        if (branches.Any(selected => TopicBranchTargetRelations.Covers(selected, branch)))
            return TopicTreeSelectionState.Checked;
        if (branches.Any(selected =>
                TopicBranchTargetRelations.IsUnder(selected, branch)
                || TopicBranchTargetRelations.PartiallyOverlaps(selected, branch)))
            return TopicTreeSelectionState.Mixed;
        return TopicTreeSelectionState.Unchecked;
    }

    private TopicTreeSelectionState GlobalSelectionState()
    {
        if (_rootBranches.IsDefaultOrEmpty)
            return TopicTreeSelectionState.Unchecked;

        var checkedRoots = 0;
        var uncheckedRoots = 0;
        foreach (var branch in _rootBranches)
        {
            switch (SelectionStateOf(branch))
            {
                case TopicTreeSelectionState.Checked:
                    checkedRoots++;
                    break;
                case TopicTreeSelectionState.Unchecked:
                    uncheckedRoots++;
                    break;
            }
        }

        if (checkedRoots == _rootBranches.Length)
            return TopicTreeSelectionState.Checked;
        return uncheckedRoots == _rootBranches.Length
            ? TopicTreeSelectionState.Unchecked
            : TopicTreeSelectionState.Mixed;
    }

    private bool? GlobalCheckboxValue => _globalState switch
    {
        TopicTreeSelectionState.Checked => true,
        TopicTreeSelectionState.Mixed => null,
        _ => false
    };

    private static string GlobalSelectLabel => "Select all topics";

    private static string GlobalSelectTitle =>
        "Selects every topic. When every topic is selected, clicking clears the selection.";

    private void OnGlobalCheckboxChanged(bool? _)
    {
        if (_rootBranches.IsDefaultOrEmpty)
            return;

        if (_globalState == TopicTreeSelectionState.Checked)
        {
            _bulkSelection.Clear();
            return;
        }

        _bulkSelection.SelectAll(_rootBranches);
    }

    private void OnSearchChanged()
    {
        BuildVisibleRows();
        StateHasChanged();
    }

    private void OnBulkSelectionChanged() => _ = InvokeAsync(() =>
    {
        if (_disposed)
            return;

        BuildVisibleRows();
        StateHasChanged();
    });

    private async Task ToggleRowSelection(TopicTreeRowModel row)
    {
        if (InheritedSelectionLabel(row) is not null)
            return;

        _bulkSelection.Toggle(row.Branch);
        _activeKey = row.RowKey;
        _focusedKey = row.RowKey;
        _tabStopFollowsFirstRow = false;
        if (OnSelectedChanged.HasDelegate)
            await OnSelectedChanged.InvokeAsync(TopicSelectionStore.GetSelectedTopicState());
    }

    private Task ToggleExpand(string path)
    {
        if (_expandedPaths.Contains(path))
            _expandedPaths.Remove(path);
        else
            _expandedPaths.Add(path);
        BuildVisibleRows();
        StateHasChanged();

        return Task.CompletedTask;
    }

    private void ExpandAll()
    {
        TopicTreeProjection.AddExpandablePaths(
            TopicSelectionStore.GetTopicTreeSnapshot().Roots, _groupSparkplugTopics, _expandedPaths);
        BuildVisibleRows();
        StateHasChanged();
    }

    private void CollapseAll()
    {
        _expandedPaths.Clear();
        BuildVisibleRows();
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _bulkSelection.Changed -= OnBulkSelectionChanged;
        UiSettings.UiPreferencesChanged -= OnUiPreferencesChanged;
        if (_updateTimer != null)
            await _updateTimer.DisposeAsync();
        await ReleaseInteropAsync();
    }
}
