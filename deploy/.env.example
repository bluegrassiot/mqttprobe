# Copy to .env and set the hostname or IP that browsers use to reach MQTT Probe.
# Compose reads .env from the directory holding the compose file, so this one
# serves deploy/docker-compose.prod.yml. It drives host filtering (AllowedHosts)
# and the TLS certificate issued by caddy. A mismatch produces either a
# 400 Bad Request - Invalid Hostname or a certificate warning.
# Examples:
#   MQTTPROBE_HOST=192.168.1.50
#   MQTTPROBE_HOST=mqttprobe.lan
MQTTPROBE_HOST=localhost