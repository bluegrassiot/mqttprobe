@namespace MqttProbe.UI.Components.Sparkplug
@using MqttProbe.Core.Models.Sparkplug

@if (!Groups.Any())
{
    @if (string.IsNullOrWhiteSpace(FilterText) && SelectedGroupId == null)
    {
        <div class="d-flex flex-column align-center pa-6">
            <MudIcon Icon="@LucideIcons.Network" Size="Size.Large" Color="Color.Secondary"/>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">
                No Sparkplug B nodes observed
            </MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                Subscribe to spBv1.0/# to begin receiving node traffic
            </MudText>
        </div>
    }
    else
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-3">
            No nodes match "@FilterText"
        </MudText>
    }
}
else
{
    @foreach (var grp in Groups)
    {
        <div class="spb-group-header">@grp.Key.ToUpperInvariant()</div>
        @foreach (var node in grp.OrderBy(n => n.NodeId, NaturalStringComparer.Instance))
        {
            var sequence = node.Sequence;
            <div @key="@($"{node.GroupId}/{node.NodeId}")" class="spb-node-row @(node.Status == SpbNodeStatus.Offline ? "spb-node-row--removable" : "") @(SelectedNode == node ? "spb-node-row--selected" : "")"
                 @onclick="() => OnSelect.InvokeAsync(node)">
                <button type="button" class="spb-node-select"
                        aria-current="@(SelectedNode == node ? "true" : null)">
                    <span class="spb-node-head d-flex align-center gap-1">
                        <span class="spb-status-dot @NodeStatusClass(node)"></span>
                        <span class="spb-node-id">@node.NodeId</span>
                        <span class="spb-status-label spb-status-label--node @NodeStatusClass(node)">
                            @SparkplugNodeDisplay.NodeStatusLabel(node)
                        </span>
                    </span>
                    <span class="spb-node-secondary">
                        @SparkplugNodeDisplay.NodeSecondaryText(node)
                    </span>
                    @if (sequence.State is SpbSequenceState.Reordering or SpbSequenceState.GapDetected or SpbSequenceState.Invalid)
                    {
                        <span class="spb-sequence-warning spb-sequence-warning--@sequence.State.ToString().ToLowerInvariant()">
                            <MudIcon Icon="@LucideIcons.AlertTriangle" Size="Size.Small" />
                            @if (sequence.State == SpbSequenceState.Reordering)
                            {
                                <span>Sequence gap · waiting</span>
                            }
                            else if (sequence.State == SpbSequenceState.GapDetected)
                            {
                                <span>Unresolved sequence gap · @sequence.MissingSequences.Count missing</span>
                            }
                            else
                            {
                                <span>Invalid sequence</span>
                            }
                        </span>
                    }
                </button>
                @if (node.Status == SpbNodeStatus.Offline)
                {
                    <span class="spb-node-remove" @onclick:stopPropagation="true">
                        <MudIconButton Icon="@LucideIcons.Trash2"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       title="Remove node from view"
                                       aria-label="@($"Remove {node.NodeId} from view")"
                                       OnClick="@(() => OnRemove.InvokeAsync(node))" />
                    </span>
                }
            </div>
        }
    }
}

@code {
    private static string NodeStatusClass(SpbNode node) => SparkplugNodeDisplay.IsStale(node)
        ? "spb-status--stale"
        : node.Status switch
        {
            SpbNodeStatus.Online => "spb-status--online",
            SpbNodeStatus.Offline => "spb-status--offline",
            _ => "spb-status--unknown"
        };

    [Parameter, EditorRequired]
    public IReadOnlyList<IGrouping<string, SpbNode>> Groups { get; set; } = [];

    [Parameter]
    public SpbNode? SelectedNode { get; set; }

    [Parameter]
    public string? FilterText { get; set; }

    [Parameter]
    public string? SelectedGroupId { get; set; }

    [Parameter]
    public EventCallback<SpbNode> OnSelect { get; set; }

    [Parameter]
    public EventCallback<SpbNode> OnRemove { get; set; }
}
