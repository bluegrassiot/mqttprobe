<Project Sdk="Microsoft.NET.Sdk.Razor">

    <!-- Optional machine-specific overrides (iOS TFM + codesign identity) for building the
         iOS app from Windows via a paired Mac. Gitignored; absent on CI and other machines,
         which then use the committed Android + Windows defaults. Imported before the TFM
         properties below so its override takes effect. -->
    <Import Project="MqttProbe.Maui.local.props" Condition="Exists('MqttProbe.Maui.local.props')" />

    <PropertyGroup>
        <LangVersion>latest</LangVersion>
        <MqttProbeMauiWindowsTargetFrameworks>net10.0-android;net10.0-windows10.0.19041.0</MqttProbeMauiWindowsTargetFrameworks>
        <MqttProbeMauiWindowsTargetFrameworks Condition="'$(MqttProbeMauiWindowsTargetFrameworksOverride)' != ''">$(MqttProbeMauiWindowsTargetFrameworksOverride)</MqttProbeMauiWindowsTargetFrameworks>
        <MqttProbeMauiMacTargetFrameworks>net10.0-ios;net10.0-maccatalyst</MqttProbeMauiMacTargetFrameworks>
        <MqttProbeMauiMacTargetFrameworks Condition="'$(MqttProbeMauiMacTargetFrameworksOverride)' != ''">$(MqttProbeMauiMacTargetFrameworksOverride)</MqttProbeMauiMacTargetFrameworks>
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">$(MqttProbeMauiMacTargetFrameworks)</TargetFrameworks>
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(MqttProbeMauiWindowsTargetFrameworks)</TargetFrameworks>
        <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('osx')) AND !$([MSBuild]::IsOSPlatform('windows'))">net10.0-android</TargetFrameworks>
		<!-- Uncomment to also build the tizen app. You will need to install tizen by following this: https://github.com/Samsung/Tizen.NET -->
        <!-- <TargetFrameworks>$(TargetFrameworks);net8.0-tizen</TargetFrameworks> -->

        <!-- Note for MacCatalyst:
            The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
            When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
            The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
            either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
        <!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->
        <OutputType>Exe</OutputType>
        <RootNamespace>MqttProbe</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <EnableDefaultCssItems>false</EnableDefaultCssItems>
        <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
        <Nullable>enable</Nullable>

        <!-- Display name -->
        <ApplicationTitle>MQTTProbe</ApplicationTitle>
        <AssemblyTitle>MQTTProbe</AssemblyTitle>

        <!-- App Identifier -->
        <ApplicationId>com.bluegrassiot.mqttprobe</ApplicationId>

        <!-- Versions -->
        <ApplicationDisplayVersion>0.0.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>

        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
        <Configurations>Debug;Release</Configurations>
        <Platforms>AnyCPU</Platforms>
    </PropertyGroup>

	<PropertyGroup Condition="'$(TargetFramework)'=='net10.0-windows10.0.19041.0'">
		<OutputType>WinExe</OutputType>
		<ApplicationIcon>..\MqttProbe.Desktop\Assets\icon.ico</ApplicationIcon>
		<WindowsPackageType>None</WindowsPackageType>
		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
		<DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
	</PropertyGroup>

	<!-- Stamp the intermediate Package.appxmanifest Identity Version from ApplicationDisplayVersion
	     so AppInfo.Current.VersionString reflects the release version, not the hardcoded default.
	     Runs after MAUI Resizetizer generates the intermediate copy, before assembly attributes are
	     extracted. Does NOT modify the source file in Platforms/Windows/. -->
	<UsingTask TaskName="StampAppxVersion" TaskFactory="RoslynCodeTaskFactory"
	           AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
		<ParameterGroup>
			<FilePath Required="true" ParameterType="System.String" />
			<NewVersion Required="true" ParameterType="System.String" />
		</ParameterGroup>
		<Task>
			<Code Type="Fragment" Language="cs">
<![CDATA[
var content = System.IO.File.ReadAllText(FilePath);
content = System.Text.RegularExpressions.Regex.Replace(
    content, @"(<Identity[^>]*?)Version=""[^""]*""", "$1Version=\"" + NewVersion + "\"");
System.IO.File.WriteAllText(FilePath, content);
]]>
			</Code>
		</Task>
	</UsingTask>
	<!-- Compute 4-part version for Appx Identity: append .0 when version has 3 parts -->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' And '$(ApplicationDisplayVersion)' != '0.0.0'">
		<_AppxManifestVersion Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(ApplicationDisplayVersion)', '^\d+\.\d+\.\d+\.\d+$'))">$(ApplicationDisplayVersion)</_AppxManifestVersion>
		<_AppxManifestVersion Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(ApplicationDisplayVersion)', '^\d+\.\d+\.\d+\.\d+$'))">$(ApplicationDisplayVersion).0</_AppxManifestVersion>
	</PropertyGroup>
	<Target Name="StampAppxManifestVersion"
	        AfterTargets="MauiGeneratePackageAppxManifest"
	        BeforeTargets="_MauiGetAssemblyAttributesFromAppxManifest"
	        Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' And '$(ApplicationDisplayVersion)' != '0.0.0'">
		<StampAppxVersion FilePath="$(_MauiIntermediateManifest)Package.appxmanifest"
		                  NewVersion="$(_AppxManifestVersion)" />
	</Target>

	<!--ANDROID SECTION-->
	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net10.0-android|AnyCPU'">
		<AndroidPackageFormat>apk</AndroidPackageFormat>
		<AndroidUseAapt2>True</AndroidUseAapt2>
		<AndroidCreatePackagePerAbi>False</AndroidCreatePackagePerAbi>
		<AndroidKeyStore>False</AndroidKeyStore>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0-android|AnyCPU'">
		<AndroidPackageFormat>aab</AndroidPackageFormat>
		<AndroidUseAapt2>True</AndroidUseAapt2>
		<AndroidCreatePackagePerAbi>False</AndroidCreatePackagePerAbi>
		<RunAOTCompilation>true</RunAOTCompilation>
		<AndroidEnableProfiledAot>true</AndroidEnableProfiledAot>
	</PropertyGroup>

	<!--IOS SECTION-->
	<PropertyGroup Condition="'$(TargetFramework)'=='net10.0-ios'">
		<BuildIpa>True</BuildIpa>
		<MtouchNoSymbolStrip>True</MtouchNoSymbolStrip>
		<!-- CodesignKey/CodesignProvision are machine-specific (per Apple Developer account).
		     Set them in MqttProbe.Maui.local.props (gitignored) to build/deploy iOS from Windows
		     via a paired Mac. See that file's import at the top of this project. -->
	</PropertyGroup>

    <PropertyGroup>
        <ServerGarbageCollection>false</ServerGarbageCollection>
        <DefaultLanguage>en-US</DefaultLanguage>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
        <GenerateAppInstallerFile>false</GenerateAppInstallerFile>
        <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
        <PackageCertificateThumbprint></PackageCertificateThumbprint>
        <AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm> <!-- DevSkim: ignore DS197836 -->
        <AppxAutoIncrementPackageRevision>false</AppxAutoIncrementPackageRevision>
        <AppxSymbolPackageEnabled>false</AppxSymbolPackageEnabled>
        <GenerateTestArtifacts>True</GenerateTestArtifacts>
        <HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
    </PropertyGroup>

    <ItemGroup>
        <MauiIcon Include="Resources\AppIcon\appicon.svg" />

        <!-- Splash Screen -->
        <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#4A575D" BaseSize="128,128" />

        <!-- Custom Fonts -->
        <MauiFont Include="Resources\Fonts\*" />

        <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
      <MauiXaml Remove="Platforms\Windows\App.xaml" />
    </ItemGroup>

    <ItemGroup>
        <None Remove="Platforms\Android\Resources\values\colors.xml" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Meziantou.Analyzer">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Maui.Controls" />
        <PackageReference Include="Microsoft.Maui.Controls.Compatibility" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
        <PackageReference Include="Microsoft.Maui.Essentials" />
        <PackageReference Include="SonarAnalyzer.CSharp">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Velopack" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' Or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\MqttProbe.Core\MqttProbe.Core.csproj" />
      <ProjectReference Include="..\MqttProbe.UI\MqttProbe.UI.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Compile Update="Platforms\Windows\App.xaml.cs">
            <DependentUpon>%(Filename)</DependentUpon>
        </Compile>
    </ItemGroup>

    <ItemGroup>
        <None Update="Platforms\Windows\Package.appxmanifest">
            <SubType>Designer</SubType>
        </None>
    </ItemGroup>

    <ItemGroup>
	    <MauiXaml Include="Platforms\Windows\App.xaml">
        <Generator>MSBuild:Compile</Generator>
      </MauiXaml>
    </ItemGroup>

    <ItemGroup>
      <Content Update="wwwroot\favicon.svg">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>

</Project>
