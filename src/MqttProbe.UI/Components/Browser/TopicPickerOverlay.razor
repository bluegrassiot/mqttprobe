@implements IDisposable
@using MqttProbe.Core.Models.Mqtt
@using MqttProbe.Core.Services.Sparkplug

@if (IsOpen)
{
    <MudFocusTrap>
        <div class="topic-picker-overlay" @onclick="ClosePicker" @onkeydown="HandleKeyDown">
            <MudPaper Class="topic-picker-overlay__panel" @onclick:stopPropagation="true"
                      role="dialog" aria-modal="true" aria-labelledby="@TitleId"
                      Elevation="8" Square="false">
                <div class="topic-picker-overlay__header">
                    <MudText Typo="Typo.subtitle1" id="@TitleId" Class="topic-picker-overlay__title">Topics</MudText>
                    <MudIconButton Icon="@LucideIcons.X" Size="Size.Small"
                                   Color="Color.Default" title="Close"
                                   OnClick="ClosePicker"/>
                </div>
                <div class="topic-picker-overlay__body">
                    <TopicBrowser TopologyService="TopologyService"
                                  OnSelectedChanged="@(_ => OnSelectionChanged())"/>
                </div>
                <div class="topic-picker-overlay__footer">
                    <span class="topic-picker-overlay__selection" role="status" aria-live="polite"
                          title="@SelectionSummary">
                        @SelectionSummary
                    </span>
                    <AppPrimaryButton Class="topic-picker-overlay__done"
                                      FullWidth="true"
                                      Disabled="@(!ShowMessagesEnabled)"
                                      OnClick="ClosePicker">
                        Show messages
                    </AppPrimaryButton>
                </div>
            </MudPaper>
        </div>
    </MudFocusTrap>
}

@code {
    private const string TitleId = "topic-picker-overlay-title";

    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public ISparkplugTopologyService? TopologyService { get; set; }

    [CascadingParameter] private TopicBulkSelection? BulkSelection { get; set; }

    [Inject] private ITopicSelectionStore TopicSelectionStore { get; set; } = null!;

    private SelectedTopicState? MetricSelection
    {
        get
        {
            var state = TopicSelectionStore?.GetSelectedTopicState();
            return state is { Mode: TopicSelectionMode.SparkplugMetric, Key: not null, Metric: not null }
                ? state
                : null;
        }
    }

    private string SelectionSummary =>
        MetricSelection?.Label ?? BulkSelection?.Summary ?? "No topics selected";

    private bool ShowMessagesEnabled =>
        MetricSelection is not null || BulkSelection?.HasSelection == true;

    protected override void OnInitialized()
    {
        if (BulkSelection is not null)
            BulkSelection.Changed += OnSelectionChanged;
    }

    private void OnSelectionChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task ClosePicker()
    {
        await OnClose.InvokeAsync();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            await ClosePicker();
    }

    public void Dispose()
    {
        if (BulkSelection is not null)
            BulkSelection.Changed -= OnSelectionChanged;
    }
}
